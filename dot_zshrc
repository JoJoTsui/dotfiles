# ~/.zshrc — interactive zsh only. Shared env comes from ~/.zshenv.
# Keep this block in sync with the interactive block of ~/.bashrc.

# zsh needs compinit before completions register (bash wires these differently)
autoload -Uz compinit && compinit
# pixi
eval "$(pixi completion --shell zsh)"

# >>> mamba initialize >>> (generated shape, --shell zsh)
export MAMBA_EXE="${MAMBA_EXE:-$(command -v micromamba || echo "${JOEY}/gizmo/micromamba")}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-${JOEY}/micromamba}"
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias micromamba="$MAMBA_EXE"
fi
unset __mamba_setup
# <<< mamba initialize <<<

# starship
eval "$(starship init zsh)"
# zoxide
eval "$(zoxide init zsh)"
# direnv
eval "$(direnv hook zsh)"
# Set up fzf key bindings and fuzzy completion
eval "$(fzf --zsh)"

# NOTE: the KIRO/VS Code prompt override intentionally lives in ~/.bashrc
# only — agent terminals spawn bash (VS Code terminal env SHELL=/bin/bash),
# not zsh.

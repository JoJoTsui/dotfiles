# Shared values arrive through .zshenv; only initialization syntax differs.
mkdir -p "${XDG_CACHE_HOME}/zsh"
autoload -Uz compinit && compinit -d "${XDG_CACHE_HOME}/zsh/zcompdump"
if command -v pixi >/dev/null 2>&1; then eval "$(pixi completion --shell zsh)"; fi
if [ -x "$MAMBA_EXE" ]; then
    _dotfiles_mamba_setup=$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)
    if [ "$?" -eq 0 ]; then eval "$_dotfiles_mamba_setup"; fi
    unset _dotfiles_mamba_setup
fi
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init zsh)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook zsh)"; fi
if command -v fzf >/dev/null 2>&1; then eval "$(fzf --zsh)"; fi
if [ -z "${_dotfiles_atuin_loaded:-}" ] && command -v atuin >/dev/null 2>&1; then
    if _dotfiles_atuin_setup=$(atuin init zsh); then
        eval "$_dotfiles_atuin_setup"
        _dotfiles_atuin_loaded=1
    fi
    unset _dotfiles_atuin_setup
fi

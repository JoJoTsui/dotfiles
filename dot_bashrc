# Shared values also reach non-interactive Bash when this file is sourced.
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"
case $- in *i*) ;; *) return ;; esac

# Initialization syntax is shell-specific. Fresh --apply-only shells can start
# before packages exist; ordinary bootstrap checks every required exposure.
if command -v pixi >/dev/null 2>&1; then eval "$(pixi completion --shell bash)"; fi
if [ -x "$MAMBA_EXE" ]; then
    _dotfiles_mamba_setup=$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)
    if [ "$?" -eq 0 ]; then eval "$_dotfiles_mamba_setup"; fi
    unset _dotfiles_mamba_setup
fi
if command -v starship >/dev/null 2>&1; then eval "$(starship init bash)"; fi
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init bash)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook bash)"; fi
if command -v fzf >/dev/null 2>&1; then eval "$(fzf --bash)"; fi
if [ -z "${_dotfiles_atuin_loaded:-}" ] && command -v atuin >/dev/null 2>&1; then
    if _dotfiles_atuin_setup=$(atuin init bash); then
        eval "$_dotfiles_atuin_setup"
        _dotfiles_atuin_loaded=1
    fi
    unset _dotfiles_atuin_setup
fi

[ ! -f "$HOME/.config/dotfiles/bash.local.sh" ] || . "$HOME/.config/dotfiles/bash.local.sh"

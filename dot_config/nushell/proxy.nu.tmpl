# Proxy helpers. The proxy URL is filled in at `chezmoi init` time from
# $HTTP_PROXY_URL (see .chezmoi.toml.tmpl).

export def --env noproxy [] {
    $env.http_proxy = {{ .proxyUrl | toJson }}
    $env.https_proxy = $env.http_proxy
    $env.HTTP_PROXY = $env.http_proxy
    $env.HTTPS_PROXY = $env.http_proxy
}

# Compatibility for the old Nu-only name.
export def --env nuproxy [] { noproxy }

export def --env unproxy [] {
    hide-env --ignore-errors http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
}

# Shared environment, generated from .chezmoidata.toml. Standalone Nu does not
# need an inherited POSIX environment or the legacy host's completion tree.
use std "path add"
$env.HOME = ($env.HOME? | default ($env.USERPROFILE? | default ("~" | path expand)))
{{ range .sharedShell.defaults -}}
{{- if (get . "base") }}
$env.{{ .name }} = ($env.{{ .name }}? | default ($env.{{ .base }} | path join {{ .suffix | toJson }}))
{{- else }}
{{- $value := get . "value" -}}
{{- if (get . "setting") }}{{ $value = index $.sharedShell .setting }}{{ end -}}
{{- if and (eq $.role "remote-compute") (get . "remote") }}{{ $value = .remote }}{{ end -}}
{{- if and (eq $.platform "windows") (get . "windows") }}{{ $value = .windows }}{{ end }}
$env.{{ .name }} = ($env.{{ .name }}? | default {{ $value | toJson }})
{{- end }}
{{ end }}
{{ range reverse .sharedShell.paths -}}
path add ($env.{{ .base }} | path join {{ .suffix | toJson }})
{{ end -}}
$env.PATH = ($env.PATH | uniq)
if ($env.LS_COLORS? | is-empty) and (which vivid | is-not-empty) {
    $env.LS_COLORS = (^vivid generate dracula)
}
$env.ENV_CONVERSIONS = ($env.ENV_CONVERSIONS? | default {} | merge {
    PATH: {
        from_string: {|value| $value | split row (char esep) }
        to_string: {|value| $value | str join (char esep) }
    }
})
$env.NU_LIB_DIRS = ($env.NU_LIB_DIRS? | default [($nu.default-config-dir | path join "scripts")])
$env.NU_PLUGIN_DIRS = ($env.NU_PLUGIN_DIRS? | default [($nu.default-config-dir | path join "plugins")])

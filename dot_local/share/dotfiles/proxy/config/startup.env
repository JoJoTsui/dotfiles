# Mihomo startup defaults. Read by scripts/configure-mihomo.py.
# Any variable here can be overridden by setting it in the environment before
# invoking configure-mihomo.py.

# Operation mode: rule | global | direct
# rule with the routing policy (scripts/apply-us-routing-policy.py): local and
# China destinations go DIRECT, advertising domains are rejected, everything
# else goes to GLOBAL, which holds the lowest-latency US leaf.
MIHOMO_MODE=rule

# IPv6 dialing. This host has no global IPv6 address, so an AAAA answer costs
# a failed connect attempt. Set false to dial IPv4 only.
MIHOMO_IPV6=false

# Local proxy endpoint. The route check fetches an exit IP through it, so a
# node is only accepted when it really serves traffic.
PROXY_HTTP=http://127.0.0.1:7890

# Region preference keyword. Picks the lowest-latency node matching this region
# and pins it into MIHOMO_PREFER_SELECTOR.
# Supported values:
#   us - matches 🇺🇸 / 美国 / US / United States / America
# Leave empty to skip region selection.
MIHOMO_PREFER_REGION=us

# Which selector group receives the chosen node.
# In global mode use GLOBAL. In rule mode use your catch-all group (e.g. 良心云).
MIHOMO_PREFER_SELECTOR=GLOBAL

# Mihomo controller URL (loopback by default).
MIHOMO_CONTROLLER=http://127.0.0.1:9090
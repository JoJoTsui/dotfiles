#!/usr/bin/env bash
# dotfiles-agent-health — preflight for the local coding-agent stack.
#
# Checks the dependency chain that fails silently after a reboot: Mihomo, its
# U.S. egress, the Codex app-server daemon, the Herdr
# server, and (in the full check) the CodeGraph and Graphify binaries. The Codex launcher runs
# the narrow `--codex` set; `--probe` adds one real model round trip.
set -u

quiet=false
probe=false
codex_only=false
clients=false
before_restore=false
for argument in "$@"; do
    case "$argument" in
        -q|--quiet) quiet=true ;;
        --probe) probe=true ;;
        --codex) codex_only=true ;;
        --clients) clients=true ;;
        --before-restore) before_restore=true ;;
        -h|--help)
            cat <<'EOF'
usage: dotfiles-agent-health [--quiet] [--codex] [--clients] [--before-restore] [--probe]

  --quiet    print failures only
  --codex    check only what a Herdr Codex launch needs (skip graph tools)
  --clients  report client binaries and config paths (diagnostic)
  --before-restore  check dependencies before starting Herdr (skip Herdr only)
  --probe    also run one Codex model round trip (uses the active provider)
EOF
            exit 0
            ;;
        *)
            printf 'unknown argument: %s\n' "$argument" >&2
            exit 2
            ;;
    esac
done

failures=0
ok() {
    [ "$quiet" = true ] || printf 'ok   %s\n' "$*"
}
fail() {
    printf 'FAIL %s\n' "$*" >&2
    failures=$((failures + 1))
}
warn() {
    [ "$quiet" = true ] || printf 'warn %s\n' "$*" >&2
}

http_code() {
    curl -sS -m "${2:-5}" -o /dev/null -w '%{http_code}' "$1" 2>/dev/null || true
}

# Run a command with a time limit. GNU timeout is not part of macOS, so the
# limit is enforced here instead of depending on a coreutils binary.
run_with_limit() {
    limit=$1
    shift
    "$@" &
    child=$!
    (sleep "$limit"; kill "$child" 2>/dev/null) &
    watchdog=$!
    # The wait redirections keep the shell's job notices out of the output
    # while the command keeps its own streams.
    wait "$child" 2>/dev/null
    status=$?
    kill "$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    return "$status"
}

# The legacy daemon stack (Mihomo, Herdr) is deployed on Linux and
# WSL only. The shared environment names the platform; the kernel name is the
# fallback for a home that has no environment yet.
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"
daemon_stack=false
case "${DOTFILES_PLATFORM:-}" in
    linux|wsl) daemon_stack=true ;;
    macos|windows) daemon_stack=false ;;
    *) [ "$(uname -s)" = Linux ] && daemon_stack=true ;;
esac

with_proxy=$(command -v with-proxy 2>/dev/null || true)
[ -n "$with_proxy" ] || with_proxy=$HOME/.local/bin/with-proxy

if [ "$daemon_stack" = true ]; then
    # Mihomo controller.
    code=$(http_code http://127.0.0.1:9090/version)
    if [ "$code" = 200 ]; then
        ok "mihomo controller (127.0.0.1:9090)"
    else
        fail "mihomo controller (127.0.0.1:9090, http ${code:-none})"
    fi

    # Egress must leave through the proxy on a U.S. node.
    if [ -x "$with_proxy" ]; then
        loc=$("$with_proxy" curl -sS -m 10 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null |
            sed -n 's/^loc=//p' | head -1)
        if [ "$loc" = US ]; then
            ok "proxy egress (US)"
        else
            fail "proxy egress (country '${loc:-unknown}', want US)"
        fi
    else
        fail "with-proxy not found"
    fi
fi

# Codex app-server daemon. The Herdr wrapper uses --no-daemon, so a stopped
# daemon is a warning for that path, not a launch blocker.
if command -v codex >/dev/null 2>&1; then
    if run_with_limit 10 codex app-server daemon version >/dev/null 2>&1; then
        ok "codex app-server daemon"
    else
        warn "codex app-server daemon not running (not needed with --no-daemon)"
    fi
else
    fail "codex not found on PATH"
fi

if [ "$daemon_stack" = true ]; then
    # Herdr server. Before restore it must not be started until dependencies pass.
    # The socket API is the structured check; the human status
    # text is not a stable contract.
    if [ "$before_restore" = true ]; then
        ok "Herdr check deferred until restore"
    elif command -v herdr >/dev/null 2>&1; then
        if herdr api snapshot >/dev/null 2>&1; then
            ok "herdr server"
        else
            fail "herdr server"
        fi
    else
        fail "herdr not found on PATH"
    fi
fi

# CodeGraph is a client MCP, not a Codex-launch dependency.
if [ "$codex_only" = false ]; then
    if command -v codegraph >/dev/null 2>&1; then
        if version=$(run_with_limit 10 codegraph --version 2>/dev/null); then
            ok "codegraph $version"
        else
            fail "codegraph cannot execute"
        fi
    else
        fail "codegraph not found on PATH"
    fi
    if command -v graphify >/dev/null 2>&1; then
        if run_with_limit 10 graphify --help >/dev/null 2>&1; then
            ok "graphify"
        else
            fail "graphify cannot execute"
        fi
    else
        fail "graphify not found on PATH (install the developer bundle)"
    fi
fi

# Optional client diagnostics; warnings only, because selection is per host.
if [ "$clients" = true ]; then
    for command_name in codex opencode claude kimi pi qoder qodercli mcode; do
        if command -v "$command_name" >/dev/null 2>&1; then
            ok "client $command_name"
        else
            warn "client $command_name missing"
        fi
    done
    for config in \
        "$HOME/.codex/config.toml" \
        "$HOME/.config/opencode/opencode.jsonc" \
        "$HOME/.claude.json" \
        "$HOME/.kimi-code/mcp.json" \
        "$HOME/.pi/agent/mcp.json" \
        "$HOME/.qoder/settings.json" \
        "$HOME/.minimax/mcp.json"; do
        if [ -f "$config" ]; then
            ok "config ${config#"$HOME"/}"
        else
            warn "config ${config#"$HOME"/} missing"
        fi
    done
fi

# Optional end-to-end model probe. This is the only step that spends tokens.
if [ "$probe" = true ]; then
    probe_log=$(mktemp "${TMPDIR:-/tmp}/dotfiles-agent-health-probe.XXXXXX") || probe_log=
    if [ -z "$probe_log" ]; then
        fail "codex model probe (cannot create a temporary log)"
    elif run_with_limit 90 "$with_proxy" codex exec -C /tmp --skip-git-repo-check \
        --sandbox read-only "Reply with HEALTH_OK and nothing else." \
        >"$probe_log" 2>&1 && grep -q HEALTH_OK "$probe_log"; then
        rm -f "$probe_log"
        ok "codex model probe"
    else
        fail "codex model probe (see $probe_log)"
    fi
fi

if [ "$failures" -ne 0 ]; then
    printf '%d check(s) failed\n' "$failures" >&2
    exit 1
fi
[ "$quiet" = true ] || printf 'agent stack healthy\n'

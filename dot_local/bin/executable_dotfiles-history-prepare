#!/bin/sh
# Generate the pinned Nu adapter only after managed Atuin and Nu exist.
set -eu
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"
: "${DOTFILES_COMMON_BIN:=$PIXI_HOME/bin}"
fail() { printf 'dotfiles-history-prepare: %s\n' "$*" >&2; exit 1; }
for command in atuin nu python; do
    [ -x "$DOTFILES_COMMON_BIN/$command" ] || fail "required managed command missing: $DOTFILES_COMMON_BIN/$command"
done
"$DOTFILES_COMMON_BIN/python" "$HOME/.local/lib/dotfiles/history.py" check
for directory in "$HOME/.local" "$XDG_DATA_HOME" "$XDG_DATA_HOME/nushell" "$XDG_DATA_HOME/nushell/vendor" "$XDG_DATA_HOME/nushell/vendor/autoload" "$ATUIN_CONFIG_DIR" "$ATUIN_DATA_DIR"; do
    [ ! -L "$directory" ] || fail "history state directory is a symlink: $directory"
done
autoload="$XDG_DATA_HOME/nushell/vendor/autoload"
mkdir -p "$autoload"
[ ! -L "$autoload/atuin.nu" ] || fail 'history startup artifact is a symlink'
temporary=$(mktemp "$autoload/.atuin.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
"$DOTFILES_COMMON_BIN/atuin" init nu > "$temporary"
chmod 600 "$temporary"
"$DOTFILES_COMMON_BIN/nu" --config "$temporary" --env-config "$XDG_CONFIG_HOME/nushell/env.nu" -c 'null'
mv -f "$temporary" "$autoload/atuin.nu"
# macOS resolves Nu's own data directory under Library/Application Support, so a
# launch without an XDG override reads that autoload directory instead of the
# one prepared here. The deployment mirrors it during
# apply-source.macos-discovery; a standalone preparation must leave the same
# bytes, or such a launch keeps the previous startup. Other platforms keep the
# deployment's discovery adapter as the only writer of native copies.
native_data=
if [ "${DOTFILES_PLATFORM:-}" = macos ]; then
    native_data=$(env -u XDG_DATA_HOME "$DOTFILES_COMMON_BIN/nu" -c 'print $nu.data-dir' 2>/dev/null) || native_data=
fi
if [ -n "$native_data" ] && [ -d "$native_data/vendor/autoload" ] && [ "$native_data/vendor/autoload" != "$autoload" ]; then
    native="$native_data/vendor/autoload"
    [ ! -L "$native/atuin.nu" ] || fail "native history artifact is a symlink: $native/atuin.nu"
    if ! cmp -s "$autoload/atuin.nu" "$native/atuin.nu"; then
        cp -p "$autoload/atuin.nu" "$native/atuin.nu"
    fi
fi
printf 'dotfiles-history-prepare: prepared Nushell history\n'

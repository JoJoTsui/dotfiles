#Requires -Version 5.1
# Install or update selected coding agents through the public bootstrap.
param(
    [Parameter(Position = 0)][string]$Command = 'help',
    [Parameter(Position = 1)][string]$Selection = 'all'
)
$ErrorActionPreference = 'Stop'
$Source = if ($env:DOTFILES_SOURCE) { $env:DOTFILES_SOURCE } else { '{{ .chezmoi.sourceDir }}' }
$Bootstrap = Join-Path $Source 'bootstrap.ps1'
$VersionTool = Join-Path $Source 'deployment/update_versions.py'
$Python = if ($env:DOTFILES_PYTHON) { $env:DOTFILES_PYTHON } else { Join-Path $HOME '.pixi/bin/python.exe' }
$Bun = if ($env:DOTFILES_BUN_BIN) { $env:DOTFILES_BUN_BIN } else { Join-Path $HOME '.pixi/bin/bun.exe' }

function Show-Usage {
    @'
Usage: dotfiles-agents.ps1 <command> [selection]

Commands:
  install [selection]  Apply source and install selected agents
  update  [selection]  Resolve current pins, refresh locks, then reinstall
  status  [selection]  Show catalog intent, last apply, and live command

selection: all (default), none, or a comma-separated list such as
           qoder,minimax,kimi. Aliases kimi-code, claude-code, and
           minimax-code are accepted.

Set DOTFILES_SOURCE when the source checkout is not at the recorded path.
'@
}

function Assert-Source {
    if (-not [IO.File]::Exists($Bootstrap) -or -not [IO.File]::Exists($VersionTool)) {
        [Console]::Error.WriteLine("dotfiles-agents: source tree not found at $Source")
        [Console]::Error.WriteLine('Set DOTFILES_SOURCE to the dotfiles checkout and retry.')
        exit 1
    }
}

function Resolve-Python {
    if (-not [IO.File]::Exists($Python)) {
        $found = Get-Command python -ErrorAction SilentlyContinue
        if (-not $found) {
            [Console]::Error.WriteLine('dotfiles-agents: Python is required for pin resolution')
            exit 1
        }
        return $found.Source
    }
    return $Python
}

function Invoke-Bootstrap([string]$Selector) {
    & powershell -NoProfile -ExecutionPolicy Bypass -File $Bootstrap -Source $Source -AgentsOnly -Agents $Selector
    exit $LASTEXITCODE
}

function Install-Agents {
    Assert-Source
    Invoke-Bootstrap $Selection
}

function Update-Agents {
    Assert-Source
    $resolvedPython = Resolve-Python
    if (-not [IO.File]::Exists($Bun)) {
        [Console]::Error.WriteLine("dotfiles-agents: pinned Bun not found at $Bun")
        exit 1
    }
    $proposalDirectory = Join-Path ([IO.Path]::GetTempPath()) ('dotfiles-agents-' + [Guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($proposalDirectory) | Out-Null
    $proposal = Join-Path $proposalDirectory 'proposal.json'
    try {
        & $resolvedPython $VersionTool propose-agents --root $Source --selection $Selection --output $proposal
        if ($LASTEXITCODE) { exit $LASTEXITCODE }
        $pending = @((Get-Content -LiteralPath $proposal -Raw | ConvertFrom-Json).agents.PSObject.Properties)
        if ($pending.Count -gt 0) {
            & $resolvedPython $VersionTool refresh --root $Source --proposal $proposal --bun $Bun
            if ($LASTEXITCODE) { exit $LASTEXITCODE }
        } else {
            Write-Output 'dotfiles-agents: selected pins are current; reinstalling without pin changes'
        }
    } finally {
        Remove-Item -LiteralPath $proposalDirectory -Recurse -Force -ErrorAction SilentlyContinue
    }
    Invoke-Bootstrap $Selection
}

function Get-AgentCatalog {
    # The native Windows deployment uses the applicable deployment-owned row.
    foreach ($line in [IO.File]::ReadAllLines((Join-Path $Source 'deployment/agents/providers.tsv'))) {
        if (-not $line -or $line.StartsWith('#')) { continue }
        $fields = $line.Split('|')
        $platforms = $fields[7].Split(',')
        if ('all' -notin $platforms -and 'windows' -notin $platforms) { continue }
        [pscustomobject]@{ name = $fields[0]; provider = $fields[1]; package = $fields[2]
                          version = $fields[4]; policy = $fields[5]; commands = $fields[6] }
    }
}

function Get-AgentState {
    # The observed provider and version of the last deployment.
    $stateRoot = if ($env:XDG_STATE_HOME) { $env:XDG_STATE_HOME } else { Join-Path $HOME '.local/state' }
    $path = Join-Path $stateRoot 'dotfiles/agents.lock.tsv'
    $state = @{}
    if (-not [IO.File]::Exists($path)) { return $state }
    foreach ($line in [IO.File]::ReadAllLines($path)) {
        if (-not $line -or $line.StartsWith('#')) { continue }
        $fields = $line.Split('|')
        if ($fields.Count -ge 3) { $state[$fields[0]] = @{ provider = $fields[1]; version = $fields[2] } }
    }
    return $state
}

function Get-DeviceOverride {
    # A device-owned agent version forces a deployment-owned install.
    param([string]$Name)
    $path = Join-Path $HOME '.config/dotfiles/versions.tsv'
    if (-not [IO.File]::Exists($path)) { return '' }
    foreach ($line in [IO.File]::ReadAllLines($path)) {
        if (-not $line -or $line.StartsWith('#')) { continue }
        $fields = $line.Split('|')
        if ($fields.Count -ge 3 -and $fields[0] -eq 'agent' -and $fields[1] -eq $Name) { return $fields[2] }
    }
    return ''
}

function Select-Agents {
    param($Rows)
    $aliases = @{ 'kimi-code' = 'kimi'; 'claude-code' = 'claude'; 'minimax-code' = 'minimax' }
    if ($Selection -eq 'all') { return @($Rows) }
    if ($Selection -eq 'none') { return @() }
    if (-not $Selection -or $Selection -match '(^,|,$|,,)') {
        [Console]::Error.WriteLine('dotfiles-agents: invalid agent selection')
        exit 1
    }
    $requested = @()
    foreach ($item in $Selection.Split(',')) {
        $canonical = if ($aliases.ContainsKey($item)) { $aliases[$item] } else { $item }
        if ($canonical -notin @($Rows.name)) {
            [Console]::Error.WriteLine("dotfiles-agents: unknown agent: $item")
            exit 1
        }
        if ($canonical -notin $requested) { $requested += $canonical }
    }
    return @($Rows | Where-Object { $_.name -in $requested })
}

function Get-LiveProvider($Row, [string]$Path) {
    $entry = $Path
    $launchers = @((Join-Path $HOME '.local/bin'), (Join-Path $HOME '.bun/bin'))
    $launcherDirectory = [IO.Path]::GetDirectoryName($Path)
    if ($launcherDirectory -in $launchers -and $Path.EndsWith('.cmd', [StringComparison]::OrdinalIgnoreCase)) {
        try { $lines = [IO.File]::ReadAllLines($Path) }
        catch { return 'unverified' }
        # Read the exact launcher form emitted by bootstrap without evaluating
        # it. A matching --version or a managed directory alone proves nothing.
        $launch = $lines | Where-Object { $_.EndsWith(' %*') } | Select-Object -First 1
        if ($lines[0] -ne '@echo off' -or -not $launch) { return 'unverified' }
        if ($Row.provider -eq 'bun' -and $launch -match '"%~dp0(?<target>\.\.\\\.\.\\[^"%]+)" %\*$') {
            $entry = [IO.Path]::GetFullPath((Join-Path $launcherDirectory $Matches.target))
        } elseif ($Row.provider -eq 'native' -and $launch -match '^"(?<target>[^"%]+)" %\*$') {
            $entry = $Matches.target
        }
    }
    if (-not [IO.File]::Exists($entry)) { return 'unverified' }
    if ($Row.provider -eq 'bun') {
        $package = [IO.Path]::GetFullPath((Join-Path $HOME ".bun/managed/$($Row.name)/node_modules/$($Row.package)"))
        if ($entry.StartsWith(($package + [IO.Path]::DirectorySeparatorChar), [StringComparison]::OrdinalIgnoreCase)) {
            return 'bun'
        }
    } elseif ($Row.provider -eq 'native') {
        $directory = [IO.Path]::GetFullPath((Join-Path $HOME ".$($Row.name)/bin/$($Row.package)"))
        if ([IO.Path]::GetDirectoryName($entry) -eq $directory -and
            [IO.Path]::GetFileName($entry).StartsWith(($Row.package + '-'), [StringComparison]::OrdinalIgnoreCase)) {
            return 'native'
        }
    }
    return 'unverified'
}

function Get-LiveCommand([string]$Name, $Row) {
    $live = @{ path = '-'; version = '-'; provider = '-'; status = 'not installed' }
    $resolved = Get-Command $Name -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $resolved) { return $live }
    $live.provider = 'unverified'
    if ($resolved.CommandType -in @('Application', 'ExternalScript')) { $live.path = $resolved.Path }
    if ($resolved.CommandType -ne 'Application') {
        $live.status = 'unverified (command is not an executable application)'
        return $live
    }
    # Windows PowerShell can surface native stderr as an error record. Keep
    # the exit status authoritative while still allowing a valid stderr version.
    $ErrorActionPreference = 'Continue'
    $global:LASTEXITCODE = 0
    try {
        $output = @(& $resolved.Path --version 2>&1)
        $code = $global:LASTEXITCODE
    } catch {
        $live.status = 'unverified (probe could not complete)'
        return $live
    }
    if ($code) {
        $live.status = "unverified (probe exited $code)"
        return $live
    }
    $first = $output | ForEach-Object { "$_".Trim() } | Where-Object { $_ } | Select-Object -First 1
    $version = [regex]::Match([string]$first, '(?<![\w.])v?(\d+(?:\.\d+)+(?:-[\w.-]+)?(?:\+[\w.-]+)?)(?![\w.])')
    if (-not $version.Success) {
        $live.status = 'unverified (no version in probe output)'
        return $live
    }
    $live.version = $version.Groups[1].Value
    $live.provider = Get-LiveProvider $Row $live.path
    $live.status = ''
    return $live
}

function Show-Status {
    Assert-Source
    $rows = Select-Agents (Get-AgentCatalog)
    $state = Get-AgentState
    if (-not $state) { $state = @{} }
    'NAME       PROVIDER EVIDENCE'
    foreach ($row in $rows) {
        $command = $row.commands.Split(',')[0]
        $version = $row.version
        $intent = "$($row.provider) =$version"
        $recorded = 'unavailable'
        if ($state.ContainsKey($row.name)) {
            $recorded = "$($state[$row.name].provider) $($state[$row.name].version)"
        }
        $override = Get-DeviceOverride $row.name
        if ($override) {
            $version = $override
            $intent += " | override: $($row.provider) =$override (device-owned version)"
        }
        $live = Get-LiveCommand $command $row
        if (-not $live.status) {
            $live.status = 'drift (version or provider mismatch)'
            if ($live.version -ceq $version -and $live.provider -in @($row.provider, 'unverified')) {
                $live.status = 'installed'
                if ($state.ContainsKey($row.name) -and
                    ($live.version -cne $state[$row.name].version -or
                     $live.provider -notin @($state[$row.name].provider, 'unverified'))) {
                    $live.status += ' (drift since last apply)'
                }
            }
        }
        '{0,-10} intent: {1} | last apply: {2} | live: {3} | provider: {4} | version: {5} | command: {6} | path: {7}' -f
            $row.name, $intent, $recorded, $live.status, $live.provider, $live.version, $command, $live.path
    }
}

switch ($Command.ToLowerInvariant()) {
    'install' { Install-Agents }
    'update' { Update-Agents }
    'status' { Show-Status }
    { $_ -in @('-h', '--help', 'help') } { Show-Usage }
    default { Show-Usage; exit 2 }
}

#!/bin/sh
# Managed by dotfiles; the Magpie launcher.
#
# macOS prefers the binary the application ships. When the application is
# absent, it can use the native CLI installed from the pinned release, like a
# headless host.
APP="${MAGPIE_APP:-/Applications/magpie.app/Contents/MacOS/magpie}"
CLI="${MAGPIE_CLI:-$HOME/.local/share/dotfiles/magpie/bin/magpie}"

platform=${DEPLOY_PLATFORM:-}
if [ -z "$platform" ]; then
    case "$(uname -s)" in
        Darwin) platform=macos ;;
        *) platform=linux ;;
    esac
fi

if [ -n "${MAGPIE_APP:-}" ] || [ "$platform" = macos ]; then
    if [ -x "$APP" ]; then
        exec "$APP" "$@"
    fi
    if [ -x "$CLI" ]; then
        exec "$CLI" "$@"
    fi
    printf 'the Magpie app is not installed; install it with: brew install --cask magpie, or install the CLI with: dotfiles-magpie install\n' >&2
    exit 127
fi

if [ ! -x "$CLI" ]; then
    printf 'the Magpie CLI is not installed; install it with: dotfiles-magpie install\n' >&2
    exit 127
fi
exec "$CLI" "$@"

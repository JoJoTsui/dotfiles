#!/bin/sh
# Rebuild only repo-owned Nu startup artifacts, after common tools exist.
set -eu
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"
: "${DOTFILES_COMMON_BIN:=$PIXI_HOME/bin}"
completions_module=${DOTFILES_COMPLETIONS_MODULE:-$HOME/.local/lib/dotfiles/completions.py}
completions_config=${DOTFILES_NU_COMPLETIONS_CONFIG:-$XDG_CONFIG_HOME/dotfiles/nu-completions.json}
fail() { printf 'dotfiles-shell-prepare: %s\n' "$*" >&2; exit 1; }
for command in nu starship zoxide fzf python wt; do
    [ -x "$DOTFILES_COMMON_BIN/$command" ] || fail "required managed command missing: $DOTFILES_COMMON_BIN/$command"
done
[ -x "$PIXI_HOME/bin/pixi" ] || fail 'managed Pixi is missing'
for directory in "$HOME/.local" "$XDG_DATA_HOME" "$XDG_DATA_HOME/nushell" "$XDG_DATA_HOME/nushell/vendor" "$XDG_DATA_HOME/nushell/vendor/autoload"; do
    [ ! -L "$directory" ] || fail "startup state directory is a symlink: $directory"
done
autoload="$XDG_DATA_HOME/nushell/vendor/autoload"
mkdir -p "$autoload"
for filename in starship.nu pixi-completions.nu fzf.nu nu-scripts.nu wt.nu; do
    [ ! -L "$autoload/$filename" ] || fail "startup artifact is a symlink: $autoload/$filename"
done
# macOS resolves Nu's own data and config directories under Library/Application
# Support, so a launch without an XDG override reads the vendor autoload
# directory and the user autoload directory instead of the one prepared here.
# The deployment mirrors the startup files during apply-source.macos-discovery;
# a standalone preparation must leave the same bytes, or such a launch keeps
# the previous startup. Other platforms keep the deployment's discovery adapter
# as their only native writer.
#
# The completion module owns the pinned loader: the deployment's catalog does
# not copy it, and the module publishes it to the native user autoload
# directory the catalog names. The vendor autoload directory is not the
# deployment's own: an earlier preparation mirrored the loader into it, so the
# module takes that copy over only when the file is demonstrably managed and
# preserves a device file of the same name.
#
# A Nu that cannot answer the discovery command must not omit a path: the
# documented macOS directories keep the publication complete, so the module
# keeps managing the canonical loader and never retires the generation that
# loader imports.
native_vendor_dir=
native_user_loader=
if [ "${DOTFILES_PLATFORM:-}" = macos ]; then
    native_user_dir="$HOME/Library/Application Support/nushell/autoload"
    native_vendor_default="$HOME/Library/Application Support/nushell/vendor/autoload"
    native_data=$(env -u XDG_DATA_HOME "$DOTFILES_COMMON_BIN/nu" -c 'print $nu.data-dir' 2>/dev/null) || native_data=
    native_config=$(env -u XDG_CONFIG_HOME "$DOTFILES_COMMON_BIN/nu" -c 'print $nu.default-config-dir' 2>/dev/null) || native_config=
    if [ -n "$native_config" ]; then
        native_user_dir="$native_config/autoload"
    fi
    if [ -n "$native_data" ]; then
        native_vendor_default="$native_data/vendor/autoload"
    fi
    if [ "$native_user_dir" != "$autoload" ]; then
        native_user_loader="$native_user_dir/nu-scripts.nu"
    fi
    if [ "$native_vendor_default" != "$autoload" ]; then
        native_vendor_dir="$native_vendor_default"
    fi
fi
stage=$(mktemp -d "$autoload/.prepare.XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
starship_temporary="$stage/starship.nu"
pixi_temporary="$stage/pixi-completions.nu"
fzf_temporary="$stage/fzf.nu"
wt_temporary="$stage/wt.nu"
"$DOTFILES_COMMON_BIN/starship" init nu > "$starship_temporary"
"$PIXI_HOME/bin/pixi" completion --shell nushell > "$pixi_temporary"
# Atuin owns Ctrl-R. Disable fzf's history binding while its adapter loads,
# then restore the device setting; file/directory widgets remain available.
printf '%s\n' 'let __dotfiles_fzf_history_command = ($env | get -o FZF_CTRL_R_COMMAND)' '$env.FZF_CTRL_R_COMMAND = ""' > "$fzf_temporary"
"$DOTFILES_COMMON_BIN/fzf" --nushell >> "$fzf_temporary"
printf '%s\n' 'if $__dotfiles_fzf_history_command == null { hide-env FZF_CTRL_R_COMMAND } else { $env.FZF_CTRL_R_COMMAND = $__dotfiles_fzf_history_command }' >> "$fzf_temporary"
"$DOTFILES_COMMON_BIN/wt" config shell init nu > "$wt_temporary"
chmod 600 "$starship_temporary" "$pixi_temporary" "$fzf_temporary" "$wt_temporary"
# Nu omits vendor autoload under -c. Validate all new resources before any
# replaces the last working artifact, then validate the managed base config.
"$DOTFILES_COMMON_BIN/nu" --config "$pixi_temporary" --env-config "$starship_temporary" -c 'null'
"$DOTFILES_COMMON_BIN/nu" --config "$fzf_temporary" --env-config "$XDG_CONFIG_HOME/nushell/env.nu" -c 'null'
"$DOTFILES_COMMON_BIN/nu" --config "$wt_temporary" --env-config "$XDG_CONFIG_HOME/nushell/env.nu" -c 'null'
"$DOTFILES_COMMON_BIN/nu" --config "$XDG_CONFIG_HOME/nushell/config.nu" --env-config "$XDG_CONFIG_HOME/nushell/env.nu" -c 'null'
# The completion module owns the pinned loader: it publishes the generation to
# every active loader and retires a generation only after no loader imports it.
set --
if [ -n "$native_vendor_dir" ]; then set -- "$@" --legacy-loader "$native_vendor_dir/nu-scripts.nu"; fi
if [ -n "$native_user_loader" ]; then set -- "$@" --loader "$native_user_loader"; fi
"$DOTFILES_COMMON_BIN/python" "$completions_module" --config "$completions_config" --nu "$DOTFILES_COMMON_BIN/nu" "$@"
mv -f "$starship_temporary" "$autoload/starship.nu"
mv -f "$pixi_temporary" "$autoload/pixi-completions.nu"
mv -f "$fzf_temporary" "$autoload/fzf.nu"
mv -f "$wt_temporary" "$autoload/wt.nu"
if [ -n "$native_vendor_dir" ] && [ -d "$native_vendor_dir" ]; then
    for filename in starship.nu pixi-completions.nu fzf.nu wt.nu; do
        [ ! -L "$native_vendor_dir/$filename" ] || fail "native startup artifact is a symlink: $native_vendor_dir/$filename"
        if ! cmp -s "$autoload/$filename" "$native_vendor_dir/$filename"; then
            cp -p "$autoload/$filename" "$native_vendor_dir/$filename"
        fi
    done
fi
printf 'dotfiles-shell-prepare: prepared Nushell startup\n'

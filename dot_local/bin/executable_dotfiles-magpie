#!/usr/bin/env bash
# Managed by dotfiles; the Magpie model gateway command.
#
# The engine is the deployment's Magpie half, copied into the home by the
# source application. The command runs the same functions the bootstrap step
# runs, so the deployment and the operator never disagree.
set -euo pipefail

usage() {
    printf 'usage: dotfiles-magpie apply|status|providers|test|start|stop|install\n' >&2
    printf '  apply      apply the model catalogs to the local gateway\n' >&2
    printf '  status     report the gateway, the providers, the groups, and the wiring\n' >&2
    printf '  providers  report the model provider catalog and its credential sources\n' >&2
    printf '  test [role...]  send one tiny completion to each model role\n' >&2
    printf '  start      start the native gateway and wait until it answers\n' >&2
    printf '  stop       stop the gateway this deployment started\n' >&2
    printf '  install    install the pinned native CLI release\n' >&2
}

command=${1:-}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
    apply|status|providers|test|start|stop|install) ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 64
        ;;
esac

# The macOS application and the native CLI are the two ways to run Magpie.
# The deployment selector decides the platform, so the command and the
# deployment step agree.
platform=${DEPLOY_PLATFORM:-}
if [ -z "$platform" ]; then
    case "$(uname -s)" in
        Darwin) platform=macos ;;
        Linux)
            if [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]; then platform=wsl; else platform=linux; fi
            ;;
        *) platform=unsupported ;;
    esac
fi
case "$platform" in
    macos|linux|wsl) ;;
    *)
        if [ "$command" = apply ]; then
            printf 'dotfiles: magpie: Magpie is not available on this platform; skipped\n'
            exit 0
        fi
        printf 'dotfiles: magpie: Magpie is not available on this platform\n' >&2
        exit 1
        ;;
esac

engine="${DOTFILES_MAGPIE_ENGINE:-$HOME/.local/share/dotfiles/magpie/engine.sh}"
if [ ! -f "$engine" ]; then
    printf 'dotfiles: magpie: the Magpie engine is missing: %s\n' "$engine" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$engine"

# A legacy account home can alias its managed .local directory to the persistent
# install tree. Resolve that tree from this command's physical location; the
# account-home guard below still runs against the inherited HOME first.
canonical_install_home=''
script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P) || script_dir=''
case "$script_dir" in
    */.local/bin) canonical_install_home=${script_dir%/.local/bin} ;;
esac

# Direct gateway commands probe the device's shared loopback port and can
# start, stop, or reconfigure a gateway. The bootstrap step guards the
# deployment path; this is the matching boundary for the command. Both inputs
# are resolved natively: an overridable platform selector or an inherited HOME
# is never an authority, so a synthetic or foreign home cannot reach the real
# account's gateway. Fail closed before any command function runs.
case "$command" in
    apply|status|providers|test|start|stop)
        # $platform comes from the overridable deployment selector; $(uname -s)
        # is the native kernel. A gateway command is only valid when the two
        # agree, so a foreign selector cannot turn a synthetic home into a
        # gateway boundary even when the real-account check is neutralized.
        direct_platform=''
        case "$platform:$(uname -s)" in
            macos:Darwin|linux:Linux|wsl:Linux) direct_platform=$platform ;;
        esac
        if [ -z "$direct_platform" ] || ! magpie_real_account_home; then
            printf 'dotfiles: magpie: the gateway commands require the real account home on a supported platform\n' >&2
            exit 1
        fi
        ;;
esac

# Only a proven account-home alias may change HOME. An unrelated .local link,
# a missing link, or a command copied elsewhere leaves the guarded home intact.
if [ -n "$canonical_install_home" ] && [ "$HOME" != "$canonical_install_home" ] &&
   [ -L "$HOME/.local" ]; then
    aliased_local=$(CDPATH='' cd -- "$HOME/.local" 2>/dev/null && pwd -P) || aliased_local=''
    if [ "$aliased_local" = "$canonical_install_home/.local" ]; then
        HOME=$canonical_install_home
        export HOME
    fi
fi

case "$command" in
    apply) magpie_apply "$@" ;;
    status) magpie_status "$@" ;;
    providers) magpie_providers "$@" ;;
    test) magpie_test "$@" ;;
    start)
        if magpie_cli_runtime; then magpie_start_gateway "$@"; else magpie_gateway_ensure "$@"; fi
        ;;
    stop) magpie_stop_gateway "$@" ;;
    install)
        if ! magpie_cli_runtime; then
            printf 'dotfiles: magpie: the macOS application provides the CLI\n' >&2
            exit 0
        fi
        magpie_install_cli
        ;;
esac

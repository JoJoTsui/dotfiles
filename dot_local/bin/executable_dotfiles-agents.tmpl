#!/usr/bin/env bash
# Install or update the selected coding agents through the public bootstrap.
# The working source tree remains authoritative; this wrapper never edits pins
# without the proposal transaction in deployment/update_versions.py.
set -euo pipefail
CALLER_PATH=$PATH
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"

SOURCE=${DOTFILES_SOURCE:-"{{ .chezmoi.sourceDir }}"}
PYTHON=${DOTFILES_PYTHON:-python3}
BOOTSTRAP="$SOURCE/bootstrap.sh"

usage() {
    cat <<'EOF'
Usage: dotfiles-agents <command> [selection]

Commands:
  install [selection]  Apply source and install selected agents
  update  [selection]  Resolve current pins, refresh locks, then reinstall
  status  [selection]  Show catalog intent, last apply, and live command

selection: all (default), none, or a comma-separated list such as
           qoder,minimax,kimi. Aliases kimi-code, claude-code, and
           minimax-code are accepted.

Set DOTFILES_SOURCE when the source checkout is not at the recorded path.
EOF
}

need_source() {
    if [ ! -f "$BOOTSTRAP" ] || [ ! -f "$SOURCE/deployment/update_versions.py" ]; then
        printf 'dotfiles-agents: source tree not found at %s\n' "$SOURCE" >&2
        printf 'Set DOTFILES_SOURCE to the dotfiles checkout and retry.\n' >&2
        exit 1
    fi
}

selection_arg() {
    if [ "$#" -gt 0 ] && [ -n "$1" ]; then printf '%s' "$1"; else printf 'all'; fi
}

install_agents() {
    local selection
    need_source
    selection=$(selection_arg "$@")
    exec bash "$BOOTSTRAP" --source "$SOURCE" --agents-only --agents "$selection"
}

lock_refresh_bun() {
    local selected=$1 proposal=$2 pin actual bun pixi
    pin=$("$PYTHON" - "$SOURCE" "$proposal" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root))
from deployment.update_versions import agent_rows, common_versions

proposal = json.loads(Path(sys.argv[2]).read_text())
if set(proposal["agents"]) & agent_rows(root).keys():
    print(common_versions(root)["bun"])
PY
    ) || { printf 'dotfiles-agents: cannot read the Bun pin for lock refresh\n' >&2; return 1; }
    # Native-only proposals do not regenerate Bun locks.
    if [ -z "$pin" ]; then printf '%s' "$selected"; return 0; fi
    case "$selected" in
        /*)
            if [ -x "$selected" ] && actual=$("$selected" --version 2>/dev/null) && [ "$actual" = "$pin" ]; then
                printf '%s' "$selected"
                return 0
            fi
            ;;
    esac
    pixi="${PIXI_HOME:-$HOME/.pixi}/bin/pixi"
    [ -x "$pixi" ] || {
        printf 'dotfiles-agents: lock refresh requires Bun %s; managed Pixi is missing at %s\n' "$pin" "$pixi" >&2
        return 1
    }
    bun=$("$pixi" exec --spec "bun==$pin" sh -c 'command -v bun') || {
        printf 'dotfiles-agents: cannot acquire Bun %s for lock refresh through managed Pixi\n' "$pin" >&2
        return 1
    }
    case "$bun" in
        /*) ;;
        *) printf 'dotfiles-agents: lock refresh requires an absolute Bun runtime from managed Pixi\n' >&2; return 1 ;;
    esac
    if [ ! -x "$bun" ] || ! actual=$("$bun" --version 2>/dev/null) || [ "$actual" != "$pin" ]; then
        printf 'dotfiles-agents: managed Pixi did not provide Bun %s for lock refresh\n' "$pin" >&2
        return 1
    fi
    printf '%s' "$bun"
}

update_agents() {
    local selection bun brew proposal_dir proposal
    need_source
    selection=$(selection_arg "$@")
    bun=${DOTFILES_BUN_BIN:-${DOTFILES_COMMON_BIN:-$HOME/.pixi/bin}/bun}
    command -v "$PYTHON" >/dev/null 2>&1 ||
        { printf 'dotfiles-agents: %s is required for pin resolution\n' "$PYTHON" >&2; exit 1; }
    proposal_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-agents.XXXXXX")
    proposal="$proposal_dir/proposal.json"
    trap 'rm -rf "$proposal_dir"' EXIT
    # Homebrew owns the installed formulas and casks: the deployment only
    # adopts what is installed, so the update brings the device's own
    # installation up to date before the deployment adopts it again. A client
    # the operator upgraded by hand and a client this upgrade upgraded end in
    # the same place, and the deployment's launcher follows the new version.
    brew=brew
    if [ -x "${DOTFILES_HOMEBREW_BIN:-}" ]; then brew=$DOTFILES_HOMEBREW_BIN; fi
    "$PYTHON" "$SOURCE/deployment/update_versions.py" upgrade-homebrew \
        --root "$SOURCE" --selection "$selection" --brew "$brew"
    "$PYTHON" "$SOURCE/deployment/update_versions.py" propose-agents \
        --root "$SOURCE" --selection "$selection" --output "$proposal"
    if "$PYTHON" -c 'import json, sys; raise SystemExit(0 if json.load(open(sys.argv[1]))["agents"] else 1)' "$proposal"; then
        bun=$(lock_refresh_bun "$bun" "$proposal")
        "$PYTHON" "$SOURCE/deployment/update_versions.py" refresh \
            --root "$SOURCE" --proposal "$proposal" --bun "$bun"
    else
        printf 'dotfiles-agents: selected pins are current; reinstalling without pin changes\n'
    fi
    rm -rf "$proposal_dir"
    trap - EXIT
    exec bash "$BOOTSTRAP" --source "$SOURCE" --agent-update --agents "$selection"
}

status_agents() {
    local selection
    need_source
    selection=$(selection_arg "$@")
    "$PYTHON" - "$SOURCE" "$selection" "$CALLER_PATH" <<'PY'
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))
from deployment.update_versions import provider_rows, selected_agents

catalog = provider_rows(root)
platform = "macos" if sys.platform == "darwin" else "linux"
# Report the same PATH that would select an executable for the caller. An
# internally sourced .env_core may have moved managed paths to the front.
os.environ["PATH"] = sys.argv[3]
version_pattern = re.compile(
    r"(?<![A-Za-z0-9._+\-])v?(\d+(?:\.\d+)+(?:-[\w.-]+)?(?:\+[\w.-]+)?)(?![A-Za-z0-9._+\-])"
)
shell_word = r"'[^'\r\n]*(?:'\\''[^'\r\n]*)*'"
launcher_pattern = re.compile(
    rf"#!/bin/sh\n# Managed by dotfiles; [^\r\n]+\n"
    rf'(?:PATH={shell_word}:"\$PATH"\nexport PATH\n)?exec (?P<entry>{shell_word}) "\$@"\n'
)


def device_override(name):
    path = Path.home() / ".config" / "dotfiles" / "versions.tsv"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) >= 3 and fields[0] == "agent" and fields[1] == name:
            return fields[2].strip()
    return ""


def recorded_state():
    # The observed provider and version of the last deployment.
    state_root = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
    path = state_root / "dotfiles" / "agents.lock.tsv"
    state = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return state
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) >= 3:
            state[fields[0]] = (fields[1], fields[2])
    return state


def records(name):
    return [row for row in catalog if row["agent"] == name]


def serving(name):
    rows = []
    for row in records(name):
        platforms = row["platforms"].split(",")
        if "all" in platforms or "unix" in platforms or platform in platforms:
            rows.append(row)
    return sorted(rows, key=lambda row: int(row["order"]))


def version_matches(observed, expected, policy):
    if policy == "exact":
        return observed == expected
    left, right = ([int(part) for part in re.match(r"[\d.]+", version).group().split(".")]
                   for version in (observed, expected))
    length = max(len(left), len(right))
    left += [0] * (length - len(left))
    right += [0] * (length - len(right))
    return left > right or (left == right and "-" not in observed.split("+", 1)[0])


def homebrew_owns(target, row):
    package = row["package"]
    if package not in target.parts:
        return False
    brew = os.environ.get("DOTFILES_HOMEBREW_BIN")
    if not brew or not os.access(brew, os.X_OK):
        brew = shutil.which("brew")
    if not brew:
        return False
    cask = row["packageKind"] == "cask"
    try:
        root = subprocess.run([brew, "--caskroom" if cask else "--cellar", package],
                              capture_output=True, text=True, check=True, timeout=30)
        directory = Path(root.stdout.strip())
        if not directory.is_absolute():
            return False
        relative = target.relative_to(directory.resolve(strict=True))
        if len(relative.parts) < 2:
            return False
        args = ["list", "--versions", "--cask", package] if cask else ["list", "--versions", package]
        listing = subprocess.run([brew, *args], capture_output=True, text=True,
                                 check=True, timeout=30)
    except (OSError, ValueError, subprocess.SubprocessError):
        return False
    return relative.parts[0] in listing.stdout.split()[1:]


def executable_provider(path, chain):
    """Identify known managed launchers or their direct provider executables."""
    home = Path.home()
    bun = Path(os.environ.get("BUN_INSTALL") or (home / ".bun"))
    target = path.resolve()
    if path.parent.resolve() in ((home / ".local/bin").resolve(), (bun / "bin").resolve()):
        # Recognize the whole emitted script. A trailing exec can be
        # unreachable or refer to a different package than what ran.
        try:
            with target.open("rb") as launcher:
                raw = launcher.read(4097)
            match = launcher_pattern.fullmatch(raw.decode())
            if match:
                entry = Path(shlex.split(match["entry"])[0])
                if entry.is_absolute() and entry.is_file():
                    target = entry.resolve()
        except (OSError, UnicodeError, ValueError):
            pass
    for row in chain:
        provider = row["provider"]
        if provider == "bun":
            project = bun / "managed" / row["agent"] / "node_modules"
            if project.resolve() in target.parents:
                return provider
        elif provider == "native":
            binary = row["package"]
            directory = home / ("." + row["agent"]) / "bin" / binary
            if target.parent == directory.resolve() and target.name.startswith(binary + "-"):
                return provider
    for row in chain:
        if row["provider"] == "homebrew" and homebrew_owns(target, row):
            return "homebrew"
    return "unverified"


def inspect_command(command, chain):
    resolved = shutil.which(command)
    if not resolved:
        return "-", "-", "-", "not installed"
    path = Path(resolved).absolute()
    try:
        result = subprocess.run([str(path), "--version"], capture_output=True, text=True,
                                errors="replace", timeout=30)
    except (OSError, subprocess.SubprocessError):
        return path, "-", "unverified", "unverified (probe could not complete)"
    if result.returncode:
        return path, "-", "unverified", f"unverified (probe exited {result.returncode})"
    diagnostic = (result.stdout.strip() or result.stderr.strip()).splitlines()
    observed = version_pattern.search(diagnostic[0]) if diagnostic else None
    if not observed:
        return path, "-", "unverified", "unverified (no version in probe output)"
    return path, observed.group(1), executable_provider(path, chain), ""


def herdr_kind(name):
    # The provider catalog is the only source of an agent's Herdr kind.
    for row in records(name):
        value = row["herdr"]
        return None if value == "-" else value
    return None


def herdr_states(kinds):
    # The managed helper owns Herdr's status vocabulary, so the report and
    # the deployment read the same state.
    if not kinds:
        return {}
    helper = Path.home() / ".local/bin/dotfiles-herdr-status"
    if not helper.is_file() or not os.access(helper, os.X_OK):
        return {kind: "unavailable" for kind in kinds}
    try:
        result = subprocess.run([str(helper), *kinds], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return {kind: "unavailable" for kind in kinds}
    states = {}
    for line in result.stdout.splitlines():
        if "|" not in line:
            continue
        kind, state = line.split("|", 1)
        states[kind.strip()] = state.strip()
    return {kind: states.get(kind, "unsupported") for kind in kinds}


state = recorded_state()
selected = selected_agents(root, sys.argv[2])
kinds = []
for name in selected:
    kind = herdr_kind(name)
    if kind:
        kinds.append(kind)
herdr = herdr_states(kinds)
print("NAME       PROVIDER EVIDENCE")
for name in selected:
    chain = serving(name)
    policies = [(row["provider"], row["version"], row["policy"]) for row in chain]
    intent = ", ".join(f"{p} {'>=' if policy == 'floor' else '='}{v}" for p, v, policy in policies)
    override = device_override(name)
    if override:
        owned = next((p for p, _, policy in policies if policy == "exact"), "-")
        policies = [(owned, override, "exact")]
        intent += f" | override: {owned} ={override} (device-owned version)"
    command = chain[0]["commands"].split(",")[0] if chain else ""
    path, observed, provider, status = inspect_command(command, chain)
    if not status:
        applicable = [row for row in policies if provider in (row[0], "unverified")]
        accepted = any(version_matches(observed, v, policy) for _, v, policy in applicable)
        status = "installed" if accepted else "drift (version or provider mismatch)"
        if accepted and name in state:
            recorded_provider, recorded_version = state[name]
            if observed != recorded_version or provider not in (recorded_provider, "unverified"):
                status += " (drift since last apply)"
    kind = herdr_kind(name)
    integration = "unsupported" if kind is None else herdr.get(kind, "unsupported")
    recorded = " ".join(state[name]) if name in state else "unavailable"
    print(f"{name:<10} intent: {intent or 'unavailable'} | last apply: {recorded} | "
          f"live: {status} | provider: {provider} | version: {observed} | "
          f"command: {command or '-'} | path: {path} | herdr: {integration}")
PY
    # A Bun global copy of a managed client cannot run: the managed launcher
    # owns the command. Report it so the leftover can be removed by name.
    (
        cd "$SOURCE"
        "$PYTHON" - "$selection" <<'PY'
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from deployment.update_versions import agent_rows, native_agent_rows, selected_agents

root = Path.cwd()
agents = agent_rows(root)
native = native_agent_rows(root)
managed = set()
for entry in list(agents.values()) + list(native.values()):
    managed.update(entry["commands"].split(","))


def device_override(name):
    path = Path.home() / ".config" / "dotfiles" / "versions.tsv"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) >= 3 and fields[0] == "agent" and fields[1] == name:
            return fields[2].strip()
    return ""


def package_bins(manifest):
    try:
        declared = json.loads(manifest.read_text(encoding="utf-8")).get("bin") or {}
    except (OSError, ValueError):
        return []
    if isinstance(declared, str):
        return [Path(declared).name]
    return list(declared)


def registries():
    roots = []
    install = os.environ.get("BUN_INSTALL")
    if install:
        roots.append(Path(install))
    roots.append(Path.home() / ".bun")
    bun = shutil.which("bun")
    if bun:
        try:
            reported = subprocess.run([bun, "pm", "bin", "-g"], capture_output=True,
                                      text=True, timeout=20).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            reported = ""
        if reported:
            roots.append(Path(reported).parent)
    unique = []
    for candidate in roots:
        if str(candidate) not in [str(item) for item in unique]:
            unique.append(candidate)
    return [item / "install" / "global" / "node_modules" for item in unique]


copies = []
for name in selected_agents(root, sys.argv[1]):
    entry = agents.get(name)
    if not entry:
        continue
    package = entry["package"]
    for registry in registries():
        manifest = registry / package / "package.json"
        if not manifest.is_file():
            continue
        try:
            version = json.loads(manifest.read_text(encoding="utf-8")).get("version", "")
        except (OSError, ValueError):
            version = ""
        bins = package_bins(manifest)
        copies.append((package, version or "unknown", manifest.parent, bins,
                       [item for item in bins if item not in managed]))
        break
if copies:
    print()
    print("GLOBAL COPIES (Bun global registry; the managed launcher owns the command)")
    for package, version, path, bins, exclusive in copies:
        print(f"  {package} {version} {path}")
        if bins:
            note = ", ".join(bins)
            if exclusive:
                note += " (" + ", ".join(exclusive) + " only here)"
            print(f"    bins: {note}")
        print(f"    remove with: bun remove -g {package}")
PY
    )
}

case "${1:-}" in
    install) shift; install_agents "$@" ;;
    update) shift; update_agents "$@" ;;
    status) shift; status_agents "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac

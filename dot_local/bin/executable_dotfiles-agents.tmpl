#!/usr/bin/env bash
# Install or update the selected coding agents through the public bootstrap.
# The working source tree remains authoritative; this wrapper never edits pins
# without the proposal transaction in deployment/update_versions.py.
set -euo pipefail
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"

SOURCE=${DOTFILES_SOURCE:-"{{ .chezmoi.sourceDir }}"}
PYTHON=${DOTFILES_PYTHON:-python3}
BOOTSTRAP="$SOURCE/bootstrap.sh"

usage() {
    cat <<'EOF'
Usage: dotfiles-agents <command> [selection]

Commands:
  install [selection]  Apply source and install selected agents
  update  [selection]  Resolve current pins, refresh locks, then reinstall
  status  [selection]  Show pinned and installed versions

selection: all (default), none, or a comma-separated list such as
           qoder,minimax,kimi. Aliases kimi-code, claude-code, and
           minimax-code are accepted.

Set DOTFILES_SOURCE when the source checkout is not at the recorded path.
EOF
}

need_source() {
    if [ ! -f "$BOOTSTRAP" ] || [ ! -f "$SOURCE/deployment/update_versions.py" ]; then
        printf 'dotfiles-agents: source tree not found at %s\n' "$SOURCE" >&2
        printf 'Set DOTFILES_SOURCE to the dotfiles checkout and retry.\n' >&2
        exit 1
    fi
}

selection_arg() {
    if [ "$#" -gt 0 ] && [ -n "$1" ]; then printf '%s' "$1"; else printf 'all'; fi
}

install_agents() {
    local selection
    need_source
    selection=$(selection_arg "$@")
    exec bash "$BOOTSTRAP" --source "$SOURCE" --agents-only --agents "$selection"
}

lock_refresh_bun() {
    local selected=$1 proposal=$2 pin actual bun pixi
    pin=$("$PYTHON" - "$SOURCE" "$proposal" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root))
from deployment.update_versions import agent_rows, common_versions

proposal = json.loads(Path(sys.argv[2]).read_text())
if set(proposal["agents"]) & agent_rows(root).keys():
    print(common_versions(root)["bun"])
PY
    ) || { printf 'dotfiles-agents: cannot read the Bun pin for lock refresh\n' >&2; return 1; }
    # Native-only proposals do not regenerate Bun locks.
    if [ -z "$pin" ]; then printf '%s' "$selected"; return 0; fi
    case "$selected" in
        /*)
            if [ -x "$selected" ] && actual=$("$selected" --version 2>/dev/null) && [ "$actual" = "$pin" ]; then
                printf '%s' "$selected"
                return 0
            fi
            ;;
    esac
    pixi="${PIXI_HOME:-$HOME/.pixi}/bin/pixi"
    [ -x "$pixi" ] || {
        printf 'dotfiles-agents: lock refresh requires Bun %s; managed Pixi is missing at %s\n' "$pin" "$pixi" >&2
        return 1
    }
    bun=$("$pixi" exec --spec "bun==$pin" sh -c 'command -v bun') || {
        printf 'dotfiles-agents: cannot acquire Bun %s for lock refresh through managed Pixi\n' "$pin" >&2
        return 1
    }
    case "$bun" in
        /*) ;;
        *) printf 'dotfiles-agents: lock refresh requires an absolute Bun runtime from managed Pixi\n' >&2; return 1 ;;
    esac
    if [ ! -x "$bun" ] || ! actual=$("$bun" --version 2>/dev/null) || [ "$actual" != "$pin" ]; then
        printf 'dotfiles-agents: managed Pixi did not provide Bun %s for lock refresh\n' "$pin" >&2
        return 1
    fi
    printf '%s' "$bun"
}

update_agents() {
    local selection bun proposal_dir proposal
    need_source
    selection=$(selection_arg "$@")
    bun=${DOTFILES_BUN_BIN:-${DOTFILES_COMMON_BIN:-$HOME/.pixi/bin}/bun}
    command -v "$PYTHON" >/dev/null 2>&1 ||
        { printf 'dotfiles-agents: %s is required for pin resolution\n' "$PYTHON" >&2; exit 1; }
    proposal_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-agents.XXXXXX")
    proposal="$proposal_dir/proposal.json"
    trap 'rm -rf "$proposal_dir"' EXIT
    "$PYTHON" "$SOURCE/deployment/update_versions.py" propose-agents \
        --root "$SOURCE" --selection "$selection" --output "$proposal"
    if "$PYTHON" -c 'import json, sys; raise SystemExit(0 if json.load(open(sys.argv[1]))["agents"] else 1)' "$proposal"; then
        bun=$(lock_refresh_bun "$bun" "$proposal")
        "$PYTHON" "$SOURCE/deployment/update_versions.py" refresh \
            --root "$SOURCE" --proposal "$proposal" --bun "$bun"
    else
        printf 'dotfiles-agents: selected pins are current; reinstalling without pin changes\n'
    fi
    rm -rf "$proposal_dir"
    trap - EXIT
    exec bash "$BOOTSTRAP" --source "$SOURCE" --agents-only --agents "$selection"
}

status_agents() {
    local selection name pin command note output state
    need_source
    selection=$(selection_arg "$@")
    printf '%-10s %-12s %-16s %s\n' NAME PIN COMMAND STATE
    (
        cd "$SOURCE"
        "$PYTHON" - "$selection" <<'PY'
import sys
from pathlib import Path
from deployment.update_versions import agent_rows, native_agent_rows, selected_agents

root = Path.cwd()
agents = agent_rows(root)
native = native_agent_rows(root)


def device_override(name):
    path = Path.home() / ".config" / "dotfiles" / "versions.tsv"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) >= 3 and fields[0] == "agent" and fields[1] == name:
            return fields[2].strip()
    return ""


for name in selected_agents(root, sys.argv[1]):
    entry = agents.get(name) or native[name]
    command = entry["commands"].split(",")[0]
    override = device_override(name)
    pin = override or entry["version"]
    print(f"{name}\t{pin}\t{command}\t{'device-owned version' if override else ''}")
PY
    ) | while IFS=$'\t' read -r name pin command note; do
        if command -v "$command" >/dev/null 2>&1; then
            output=$("$command" --version 2>&1 | head -n1 || true)
            case "$output" in
                *"$pin"*) state=installed ;;
                *) state="mismatch (${output:-no version output})" ;;
            esac
        else
            state='not installed'
        fi
        printf '%-10s %-12s %-16s %s\n' "$name" "$pin" "$command" "$state${note:+ ($note)}"
    done
    # A Bun global copy of a managed client cannot run: the managed launcher
    # owns the command. Report it so the leftover can be removed by name.
    (
        cd "$SOURCE"
        "$PYTHON" - "$selection" <<'PY'
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from deployment.update_versions import agent_rows, native_agent_rows, selected_agents

root = Path.cwd()
agents = agent_rows(root)
native = native_agent_rows(root)
managed = set()
for entry in list(agents.values()) + list(native.values()):
    managed.update(entry["commands"].split(","))


def device_override(name):
    path = Path.home() / ".config" / "dotfiles" / "versions.tsv"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) >= 3 and fields[0] == "agent" and fields[1] == name:
            return fields[2].strip()
    return ""


def package_bins(manifest):
    try:
        declared = json.loads(manifest.read_text(encoding="utf-8")).get("bin") or {}
    except (OSError, ValueError):
        return []
    if isinstance(declared, str):
        return [Path(declared).name]
    return list(declared)


def registries():
    roots = []
    install = os.environ.get("BUN_INSTALL")
    if install:
        roots.append(Path(install))
    roots.append(Path.home() / ".bun")
    bun = shutil.which("bun")
    if bun:
        try:
            reported = subprocess.run([bun, "pm", "bin", "-g"], capture_output=True,
                                      text=True, timeout=20).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            reported = ""
        if reported:
            roots.append(Path(reported).parent)
    unique = []
    for candidate in roots:
        if str(candidate) not in [str(item) for item in unique]:
            unique.append(candidate)
    return [item / "install" / "global" / "node_modules" for item in unique]


copies = []
for name in selected_agents(root, sys.argv[1]):
    entry = agents.get(name)
    if not entry:
        continue
    package = entry["package"]
    for registry in registries():
        manifest = registry / package / "package.json"
        if not manifest.is_file():
            continue
        try:
            version = json.loads(manifest.read_text(encoding="utf-8")).get("version", "")
        except (OSError, ValueError):
            version = ""
        bins = package_bins(manifest)
        copies.append((package, version or "unknown", manifest.parent, bins,
                       [item for item in bins if item not in managed]))
        break
if copies:
    print()
    print("GLOBAL COPIES (Bun global registry; the managed launcher owns the command)")
    for package, version, path, bins, exclusive in copies:
        print(f"  {package} {version} {path}")
        if bins:
            note = ", ".join(bins)
            if exclusive:
                note += " (" + ", ".join(exclusive) + " only here)"
            print(f"    bins: {note}")
        print(f"    remove with: bun remove -g {package}")
PY
    )
}

case "${1:-}" in
    install) shift; install_agents "$@" ;;
    update) shift; update_agents "$@" ;;
    status) shift; status_agents "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# codex-herdr — launch Codex for a Herdr pane.
#
# Herdr's Codex integration needs the app-server in-process so hooks inherit the
# pane's HERDR_PANE_ID; the shared daemon keeps the environment of the pane it
# first started in and reports every session to that pane. The wrapper also
# checks the local stack and inherits the outbound proxy for Codex's
# account/read call.
#
# Two routes leave this wrapper, and they stay distinct:
#
#   * A fresh launch keeps the plain route: codex --no-daemon. It starts a
#     new session, so the configuration of the device selects its provider.
#   * A restore resumes a thread that saved its own provider, model, and
#     reasoning effort. Codex refuses a resume whose thread saved another
#     provider than the current configuration selects, so a restore goes
#     through the managed resume command, which carries provider definitions
#     only and selects nothing.
#
# Both routes keep the health gate, the proxy gate, and the in-process app
# server, so the hooks of a restored session still report to the pane that
# restored them.
set -uo pipefail

health=${DOTFILES_AGENT_HEALTH:-$HOME/.local/bin/dotfiles-agent-health}
with_proxy=${DOTFILES_WITH_PROXY:-$HOME/.local/bin/with-proxy}
resume_command=${DOTFILES_CODEX_RESUME:-$HOME/.local/bin/dotfiles-codex-resume}

if [ ! -x "$health" ]; then
    printf 'codex-herdr: %s is missing\n' "$health" >&2
    exit 1
fi
if [ ! -x "$with_proxy" ]; then
    printf 'codex-herdr: %s is missing\n' "$with_proxy" >&2
    exit 1
fi
if ! "$health" --quiet --codex; then
    printf 'codex-herdr: agent stack is unhealthy; refusing to launch\n' >&2
    exit 1
fi

# The outbound proxy is optional and its port belongs to whichever client the
# device runs, so let with-proxy decide per launch: it uses a reachable proxy,
# and otherwise drops inherited proxy variables before starting. Inheriting a
# stale http_proxy is what made a pane report "connection failed" while a shell
# without those variables reached the same endpoint.
#
# The managed launcher answers --if-available: with no reachable endpoint it
# starts the command direct. A launcher that does not know the option would
# exec it as a command and fail, so the launcher is asked once with a harmless
# command. A launcher that cannot answer keeps the proxied route it had
# before the flag existed, which is what a legacy tree's own with-proxy does.
launcher_accepts_if_available() {
    "$with_proxy" --if-available true >/dev/null 2>&1
}

run_with_proxy() {
    if launcher_accepts_if_available; then
        exec "$with_proxy" --if-available "$@"
    fi
    exec "$with_proxy" "$@"
}

if [ "${1:-}" = resume ]; then
    shift
    if [ ! -x "$resume_command" ]; then
        printf 'codex-herdr: %s is missing\n' "$resume_command" >&2
        exit 1
    fi
    # The managed command adds the provider definitions and never a selection,
    # so the resumed thread keeps the provider, the model, and the reasoning
    # effort it saved. --no-daemon keeps the app server in the pane.
    run_with_proxy "$resume_command" --no-daemon "$@"
fi

run_with_proxy codex --no-daemon "$@"

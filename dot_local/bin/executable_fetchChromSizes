#!/bin/sh
# UCSC chromosome sizes, using the bio bundle's managed HTTPS transport.
set -eu

usage() {
    printf 'Usage: fetchChromSizes <UCSC-database> > <database>.chrom.sizes\n'
    printf 'Fetch chromosome sizes over HTTPS using curl (for example, hg38).\n'
}

case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    ''|*[!A-Za-z0-9_]*) usage >&2; exit 2 ;;
esac
[ "$#" -eq 1 ] || { usage >&2; exit 2; }
database=$1
base="https://hgdownload.soe.ucsc.edu/goldenPath/$database/bigZips"
case "$database" in hg19|hg38) base="$base/latest" ;; esac
exec curl --fail --location --silent --show-error "$base/$database.chrom.sizes"

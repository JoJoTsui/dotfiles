#!/usr/bin/env bash
# with-proxy — wrap a command with proxy env vars set, then exec it.
#
# Default usage is direct. Opt in to the proxy per invocation:
#   with-proxy curl -fsSL https://blocked.example.com/file.tar.gz
#   with-proxy codex --model gpt-4
#   with-proxy aria2c --all-proxy="$PROXY_HTTP" https://example.com/big.iso
#
# Works in any shell, subshell, CI step, or script — it is a real executable
# in $PATH, not a shell alias.
#
# Upper and lowercase spellings are always set together, so a command cannot
# inherit one spelling from its parent and read the other.
#
# NO_PROXY is set to the local list rather than inherited: an inherited bypass
# list could send a public destination around the proxy route.
#
# The endpoint is resolved per call, not per platform. A port belongs to the
# proxy process that owns it: the managed mihomo defaults to 7890 and Clash
# Verge to 7897, on every OS. So this probes the usual ports instead of
# branching on uname, and the same dotfiles work on a Mac running Clash Verge
# and on a headless host running the deployment instance.
#
# Env knobs (an explicit value always skips the probe):
#   PROXY_HTTP   default: probed, else http://127.0.0.1:7890
#   PROXY_SOCKS  default: socks5h:// on the same host:port as PROXY_HTTP
#   PROXY_NO     default localhost,127.0.0.1,::1
#
# --print emits the export lines instead of exec'ing, which is how the shell
# helper in .env_core reuses this resolution without copying the port list.

set -euo pipefail

PROXY_NO=${PROXY_NO:-localhost,127.0.0.1,::1}
mode=exec
if_available=0

case ${1:-} in
    --print) mode=print; shift ;;
    --print-url) mode=url; shift ;;
    --if-available) if_available=1; shift ;;
esac

available=0
if [[ -n ${PROXY_HTTP:-} ]]; then
    available=1
else
    for _port in 7897 7890; do
        if nc -z 127.0.0.1 "$_port" 2>/dev/null; then
            PROXY_HTTP="http://127.0.0.1:$_port"
            available=1
            break
        fi
    done
fi
PROXY_HTTP=${PROXY_HTTP:-http://127.0.0.1:7890}
PROXY_SOCKS=${PROXY_SOCKS:-socks5h://${PROXY_HTTP#http://}}

if [[ $mode == url ]]; then
    printf '%s\n' "$PROXY_HTTP"
    exit 0
fi

if [[ $mode == print ]]; then
    printf 'export HTTP_PROXY=%q\n' "$PROXY_HTTP"
    printf 'export HTTPS_PROXY=%q\n' "$PROXY_HTTP"
    printf 'export http_proxy=%q\n' "$PROXY_HTTP"
    printf 'export https_proxy=%q\n' "$PROXY_HTTP"
    printf 'export ALL_PROXY=%q\n' "$PROXY_SOCKS"
    printf 'export all_proxy=%q\n' "$PROXY_SOCKS"
    printf 'export NO_PROXY=%q\n' "$PROXY_NO"
    printf 'export no_proxy=%q\n' "$PROXY_NO"
    printf 'export PROXY=%q\n' "$PROXY_HTTP"
    exit 0
fi

if [[ $# -eq 0 ]]; then
    echo "usage: with-proxy [--print|--print-url|--if-available] command [args...]" >&2
    exit 64
fi

# --if-available: a caller that only wants the proxy when one exists. Without a
# reachable endpoint it runs direct and drops inherited variables, so a stale
# http_proxy in the parent cannot make the command fail against a dead port.
if [[ $mode == exec && $if_available == 1 && $available == 0 ]]; then
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
    unset ALL_PROXY all_proxy FTP_PROXY ftp_proxy
    unset NO_PROXY no_proxy PROXY
    exec -- "$@"
fi

export HTTP_PROXY="$PROXY_HTTP"
export HTTPS_PROXY="$PROXY_HTTP"
export http_proxy="$PROXY_HTTP"
export https_proxy="$PROXY_HTTP"
export ALL_PROXY="$PROXY_SOCKS"
export all_proxy="$PROXY_SOCKS"
export NO_PROXY="$PROXY_NO"
export no_proxy="$PROXY_NO"
export PROXY="$PROXY_HTTP"

exec -- "$@"

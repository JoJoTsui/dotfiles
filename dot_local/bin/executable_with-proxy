#!/usr/bin/env bash
# with-proxy — wrap a command with proxy env vars set, then exec it.
#
# Default usage is direct. Opt in to the proxy per invocation:
#   with-proxy curl -fsSL https://blocked.example.com/file.tar.gz
#   with-proxy codex --model gpt-4
#   with-proxy aria2c --all-proxy="$PROXY_HTTP" https://example.com/big.iso
#
# Works in any shell, subshell, CI step, or script — it is a real executable
# in $PATH, not a shell alias.
#
# This launcher owns the endpoint decision: the precedence, the health check,
# and the fallback live here, and every other adapter (the POSIX shell helper
# in .env_core, the Nushell adapter in proxy.nu) reads the answer from here.
# A session in Nushell and a session in Bash therefore route the same way.
#
# Upper and lowercase spellings are always set together, so a command cannot
# inherit one spelling from its parent and read the other.
#
# NO_PROXY is set to the local list rather than inherited: an inherited bypass
# list could send a public destination around the proxy route.
#
# The endpoint is resolved per call, not per platform. A port belongs to the
# proxy process that owns it: the managed mihomo defaults to 7890 and Clash
# Verge to 7897, on every OS. So this probes the usual ports instead of
# branching on uname, and the same dotfiles work on a Mac running Clash Verge
# and on a headless host running the deployment instance.
#
# Env knobs (an explicit value always skips the probe):
#   PROXY_HTTP   default: probed, else http://127.0.0.1:7890
#   PROXY_SOCKS  default: socks5h:// on the same host:port as PROXY_HTTP
#   PROXY_NO     default localhost,127.0.0.1,::1
#
# Output modes (the interface the adapters read):
#   --print                    export lines for the supported variables
#   --print-env                KEY=VALUE lines for the supported variables
#   --print-url                the endpoint, with the ordinary fallback
#   --print-url-if-available   the endpoint, or exit 1 when none is available
#
# --print emits the export lines instead of exec'ing, which is how the shell
# helper in .env_core reuses this resolution without copying the port list.
# The export lines carry POSIX single-quoted literals, so every shell reads
# the same value out of them.
# --print-url-if-available emits no fallback when neither a value nor a
# listener is available, for callers that persist the chosen endpoint.
# --print-env answers the same question in a form a non-shell adapter can
# parse, so the Nushell session helper applies exactly the variables this
# launcher applies.
#
# The bindings carry fixed variable names and single-line values. The names
# live in this file and the value each name carries is fixed, so a value never
# chooses the name it is bound to. The overrides are single-line values, and
# an override that carries a line separator is refused before any binding is
# emitted: a second line in a value would be read as another variable name.

set -euo pipefail

PROXY_NO=${PROXY_NO:-localhost,127.0.0.1,::1}
mode=exec
if_available=0

case ${1:-} in
    --print) mode=print; shift ;;
    --print-url) mode=url; shift ;;
    --print-url-if-available) mode=available-url; shift ;;
    --print-env) mode=env; shift ;;
    --if-available) if_available=1; shift ;;
esac

# The supported overrides are single-line values. A line separator inside one
# would split a binding into another line, and that line would be read as
# another variable name, so the override is refused before any binding is
# emitted and before the child runs.
refuse_line_separator() {
    if [[ $2 == *$'\n'* || $2 == *$'\r'* ]]; then
        printf 'with-proxy: %s must not contain a line separator\n' "$1" >&2
        exit 64
    fi
}
refuse_line_separator PROXY_HTTP "${PROXY_HTTP:-}"
refuse_line_separator PROXY_SOCKS "${PROXY_SOCKS:-}"
refuse_line_separator PROXY_NO "$PROXY_NO"

# The decision, in one place: an explicit endpoint wins, otherwise the ports a
# proxy client may serve are probed in order, and a caller that asked for an
# available endpoint gets nothing rather than the ordinary fallback.
available=0
if [[ -n ${PROXY_HTTP:-} ]]; then
    available=1
else
    for _port in 7897 7890; do
        if nc -z 127.0.0.1 "$_port" 2>/dev/null; then
            PROXY_HTTP="http://127.0.0.1:$_port"
            available=1
            break
        fi
    done
fi
if [[ $available == 0 && $mode == available-url ]]; then
    exit 1
fi
PROXY_HTTP=${PROXY_HTTP:-http://127.0.0.1:7890}
PROXY_SOCKS=${PROXY_SOCKS:-socks5h://${PROXY_HTTP#http://}}

# The variables the launchers own, in export order. The POSIX launcher and the
# Nushell adapter both read this list, so a change to it reaches both.
proxy_names() {
    printf '%s\n' HTTP_PROXY HTTPS_PROXY http_proxy https_proxy \
        ALL_PROXY all_proxy NO_PROXY no_proxy PROXY
}

# The value a name carries. The mapping is fixed as well: a value never
# chooses the name it is bound to.
proxy_value() {
    case $1 in
        ALL_PROXY|all_proxy) printf '%s' "$PROXY_SOCKS" ;;
        NO_PROXY|no_proxy) printf '%s' "$PROXY_NO" ;;
        *) printf '%s' "$PROXY_HTTP" ;;
    esac
}

# Render a value as a POSIX single-quoted shell literal. Bash's %q answers
# with an ANSI-C $'...' quote, which is a bash extension: a POSIX shell reads
# the '$' and the escape sequences as ordinary characters, so a tab or a quote
# in an override reaches the session altered. The single-quoted form reads the
# same in every shell, and an embedded quote is closed, escaped, and reopened.
posix_quote() {
    local value=$1 literal="" head=""
    while :; do
        case $value in
            *"'"*)
                head=${value%%"'"*}
                literal="$literal$head'\\''"
                value=${value#*"'"}
                ;;
            *)
                literal="$literal$value"
                break
                ;;
        esac
    done
    printf "'%s'" "$literal"
}

# Emit or apply the owned variables.
#   env     KEY=VALUE lines, for an adapter that reads them
#   export  export lines, for a POSIX session that evaluates them
#   apply   the variables of this process, for the child
proxy_bindings() {
    local form=$1 name value
    while IFS= read -r name; do
        value=$(proxy_value "$name")
        case $form in
            env) printf '%s=%s\n' "$name" "$value" ;;
            export) printf 'export %s=%s\n' "$name" "$(posix_quote "$value")" ;;
            apply) export "$name=$value" ;;
        esac
    done < <(proxy_names)
}

case $mode in
    url|available-url)
        printf '%s\n' "$PROXY_HTTP"
        exit 0
        ;;
    env)
        proxy_bindings env
        exit 0
        ;;
    print)
        proxy_bindings export
        exit 0
        ;;
esac

if [[ $# -eq 0 ]]; then
    echo "usage: with-proxy [--print|--print-url|--print-url-if-available|--print-env|--if-available] command [args...]" >&2
    exit 64
fi

# --if-available: a caller that only wants the proxy when one exists. Without a
# reachable endpoint it runs direct and drops inherited variables, so a stale
# http_proxy in the parent cannot make the command fail against a dead port.
if [[ $if_available == 1 && $available == 0 ]]; then
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
    unset ALL_PROXY all_proxy FTP_PROXY ftp_proxy
    unset NO_PROXY no_proxy PROXY
    exec -- "$@"
fi

proxy_bindings apply

exec -- "$@"

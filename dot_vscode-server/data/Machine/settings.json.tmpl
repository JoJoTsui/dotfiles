{{- $home := .chezmoi.homeDir -}}
{{- $suffix := "linux" -}}
{{- $bash := printf "%s/.pixi/bin/bash" $home -}}
{{- $nu := printf "%s/.pixi/bin/nu" $home -}}
{{- $mamba := printf "%s/.pixi/bin/micromamba" $home -}}
{{- $python := "${workspaceFolder}/.venv/bin/python" -}}
{{- if eq .platform "macos" -}}{{- $suffix = "osx" -}}{{- end -}}
{{- if eq .platform "windows" -}}
{{- $suffix = "windows" -}}
{{- $bash = printf "%s/.local/share/dotfiles/git-bash/bin/bash.exe" $home -}}
{{- $nu = printf "%s/.local/bin/dotfiles-shell.cmd" $home -}}
{{- $mamba = printf "%s/.pixi/bin/micromamba.exe" $home -}}
{{- $python = "${workspaceFolder}/.venv/Scripts/python.exe" -}}
{{- end -}}
{
    // Remote compute machine settings use the selected platform's managed tools.
    "python.condaPath": {{ $mamba | toJson }},
    "python.venvPath": {{ printf "%s/.local/share/micromamba/envs" $home | toJson }},
    "remote.SSH.defaultForwardedPorts": [],
    "remote.SSH.httpProxy": "",
    "http.proxy": {{ .proxyUrl | toJson }},

    // Bash keeps Claude subprocess semantics; Nushell remains a selectable profile.
    "terminal.integrated.defaultProfile.{{ $suffix }}": "bash",
    "terminal.integrated.profiles.{{ $suffix }}": {
        "bash": {
            "path": {{ $bash | toJson }},
            "args": ["--login", "-i"],
            "env": { "DOTFILES_SECONDARY_SHELL": "1" }
        },
        "nushell": {
            "path": {{ $nu | toJson }}{{ if ne .platform "windows" }},
            "args": ["--login"]{{ end }}
        }
    },
    "terminal.integrated.env.{{ $suffix }}": {
        "SHELL": {{ $bash | toJson }},
        "CHOKIDAR_USEPOLLING": "1"
    },

    // Python tooling: uv + ruff + ty.
    "python.defaultInterpreterPath": {{ $python | toJson }},
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "ruff.nativeServer": "on",
    "python.languageServer": "None",
    "ty.enabled": true,
    "ty.typeCheckingMode": "standard"
}

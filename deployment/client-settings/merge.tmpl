{{- /* Chezmoi provides the JSONC/TOML parsers on every bootstrap target. */ -}}
{{- define "client-defaults" -}}
{{- $host := index . 0 -}}
{{- $defaults := index . 1 -}}
{{- $previous := index . 2 -}}
{{- range $key, $value := $defaults -}}
{{- if not (hasKey $host $key) -}}
{{- $_ := set $host $key $value -}}
{{- else if and (kindIs "map" $value) (kindIs "map" (get $host $key)) -}}
{{- $old := dict -}}
{{- if and (hasKey $previous $key) (kindIs "map" (get $previous $key)) -}}{{- $old = get $previous $key -}}{{- end -}}
{{- template "client-defaults" (list (get $host $key) $value $old) -}}
{{- else if and (eq $key "skills") (kindIs "slice" $value) (kindIs "slice" (get $host $key)) -}}
{{- /* Keep user skill paths while always registering the shared library. */ -}}
{{- $skills := get $host $key -}}
{{- range $path := $value -}}{{- if not (has $path $skills) -}}{{- $skills = append $skills $path -}}{{- end -}}{{- end -}}
{{- $_ := set $host $key $skills -}}
{{- else if and (hasKey $previous $key) (deepEqual (get $host $key) (get $previous $key)) -}}
{{- $_ := set $host $key $value -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- define "client-redact-baseline" -}}
{{- range $key, $value := . -}}
{{- if regexMatch "(?i)(api_?key|auth_?token|authorization|password|secret|token)$" $key -}}
{{- $_ := unset $ $key -}}
{{- else if kindIs "map" $value -}}
{{- template "client-redact-baseline" $value -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $format := env "DOTFILES_SETTINGS_FORMAT" -}}
{{- $target := env "DOTFILES_SETTINGS_TARGET" -}}
{{- $baseline := env "DOTFILES_SETTINGS_BASELINE" -}}
{{- $source := env "DOTFILES_SETTINGS_SOURCE" -}}
{{- $desiredText := includeTemplate $source . -}}
{{- $desired := dict -}}
{{- $host := dict -}}
{{- $previous := dict -}}
{{- if eq $format "toml" -}}
{{- $desired = fromToml $desiredText -}}
{{- if lstat $target -}}{{- $host = include $target | fromToml -}}{{- end -}}
{{- else if eq $format "yaml" -}}
{{- $desired = fromYaml $desiredText -}}
{{- if lstat $target -}}{{- $host = include $target | fromYaml -}}{{- end -}}
{{- else -}}
{{- $desired = fromJsonc $desiredText -}}
{{- if lstat $target -}}{{- $host = include $target | fromJsonc -}}{{- end -}}
{{- end -}}
{{- /* Native clients can spawn an .exe directly; .cmd wrappers are not a
       portable stdio MCP command. Keep this in the shared merge contract. */ -}}
{{- if eq .platform "windows" -}}
{{- $node := joinPath (env "PIXI_HOME") "bin" "node.exe" -}}
{{- $shim := joinPath (env "HOME") ".bun" "managed" "codegraph" "node_modules" "@colbymchenry" "codegraph" "npm-shim.js" -}}
{{- $policy := env "DOTFILES_SETTINGS_POLICY" -}}
{{- if eq $policy "codegraph-mcp" -}}
{{- $_ := setValueAtPath (list "mcpServers" "codegraph" "command") $node $desired -}}
{{- $_ := setValueAtPath (list "mcpServers" "codegraph" "args") (list $shim "serve" "--mcp") $desired -}}
{{- else if eq $policy "codex" -}}
{{- $_ := setValueAtPath (list "mcp_servers" "codegraph" "command") $node $desired -}}
{{- $_ := setValueAtPath (list "mcp_servers" "codegraph" "args") (list $shim "serve" "--mcp") $desired -}}
{{- else if eq $policy "opencode" -}}
{{- $_ := setValueAtPath (list "mcp" "servers" "codegraph" "command") (list $node $shim "serve" "--mcp") $desired -}}
{{- else if eq $policy "pi-settings" -}}
{{- $_ := set $desired "shellPath" (env "KIMI_SHELL_PATH") -}}
{{- end -}}
{{- end -}}
{{- if not (kindIs "map" $host) -}}{{- fail "client config must be an object/table" -}}{{- end -}}
{{- if lstat $baseline -}}{{- $previous = include $baseline | fromJson -}}{{- end -}}
{{- if eq (env "DOTFILES_SETTINGS_OUTPUT") "baseline" -}}
{{- template "client-redact-baseline" $desired -}}
{{ $desired | toPrettyJson }}
{{- else -}}
{{- template "client-defaults" (list $host $desired $previous) -}}
{{- $policies := include "deployment/client-settings/policies.json" | fromJson -}}
{{- $policy := env "DOTFILES_SETTINGS_POLICY" -}}
{{- /* Retire the legacy Claude RTK adapter only. Codex rejects its updatedInput
      without permissionDecision:allow; shared instructions use explicit RTK.
      Other commands, matchers, events and device metadata remain device-owned. */ -}}
{{- if and (eq $policy "codex-hooks") (hasKey $host "hooks") -}}
{{- $hooks := get $host "hooks" -}}
{{- if not (kindIs "map" $hooks) -}}{{- fail "Codex hooks must be an object" -}}{{- end -}}
{{- if hasKey $hooks "PreToolUse" -}}
{{- $groups := get $hooks "PreToolUse" -}}
{{- if not (kindIs "slice" $groups) -}}{{- fail "Codex PreToolUse must be an array" -}}{{- end -}}
{{- range $group := $groups -}}
{{- $commands := get $group "hooks" -}}
{{- if not (kindIs "slice" $commands) -}}{{- fail "Codex hook group must contain a hooks array" -}}{{- end -}}
{{- $remaining := list -}}
{{- $removed := false -}}
{{- range $hook := $commands -}}
{{- if and (eq (get $hook "type") "command") (eq (get $hook "command") "rtk hook claude") -}}
{{- $removed = true -}}
{{- else -}}{{- $remaining = append $remaining $hook -}}{{- end -}}
{{- end -}}
{{- if $removed -}}{{- $_ := set $group "hooks" $remaining -}}{{- end -}}
{{- end -}}
{{- /* Keep empty groups: Codex hook trust records include group positions. */ -}}
{{- end -}}
{{- end -}}
{{- /* The pinned Claude client can migrate plain opus to opus[1m] while
      initializing plugins. Preserve only the installer's exact prior choice;
      explicit context/custom models and all runtime metadata stay client-owned. */ -}}
{{- if and (eq $policy "claude-settings") (eq (env "DOTFILES_SETTINGS_KEEP_PLAIN_OPUS") "1") (kindIs "string" (get $host "model")) (eq (get $host "model") "opus[1m]") -}}
{{- $_ := set $host "model" "opus" -}}
{{- end -}}
{{- if not (hasKey $policies $policy) -}}{{- fail (printf "unknown client settings policy %q" $policy) -}}{{- end -}}
{{- range $path := get $policies $policy -}}
{{- $value := $desired -}}
{{- range $part := $path -}}{{- $value = get $value $part -}}{{- end -}}
{{- $_ := setValueAtPath $path $value $host -}}
{{- end -}}
{{- if eq $format "toml" -}}
{{ $host | toToml }}
{{- else if eq $format "yaml" -}}
{{- /* Preserve device bytes and mtime when no settings changed: the gateway
       publishes configuration changes by restarting after a newer file. */ -}}
{{- if and (lstat $target) (deepEqual $host (include $target | fromYaml)) -}}
{{ include $target }}
{{- else -}}
{{ $host | toYaml }}
{{- end -}}
{{- else -}}
{{- if and (eq $policy "codex-hooks") (lstat $target) (deepEqual $host (include $target | fromJsonc)) -}}
{{ include $target }}
{{- else -}}
{{ $host | toPrettyJson }}
{{- end -}}
{{- end -}}
{{- end -}}

# Shared POSIX environment, generated from .chezmoidata.toml.
# Idempotent, and safe for dash, Bash 3.2 and Zsh.
# Load device inputs before shared defaults; this file must also be POSIX-safe.
if [ -f "$HOME/.config/dotfiles/env.local.sh" ]; then
    . "$HOME/.config/dotfiles/env.local.sh"
fi
{{ if eq .platform "windows" -}}
# Git Bash uses POSIX paths for its PATH but Windows-absolute roots for native
# Rust/Python tools. Their filesystem parsers do not understand /c/... paths.
_dotfiles_native_home=$HOME
if command -v cygpath >/dev/null 2>&1; then
    _dotfiles_native_home=$(cygpath -m "$HOME")
fi
{{ end -}}
{{- $defaults := .sharedShell.defaults -}}
{{- if eq .platform "windows" -}}{{- $defaults = concat $defaults .sharedShell.windowsDefaults -}}{{- end -}}
{{ range $defaults -}}
{{- if (get . "base") }}
{{- $base := .base -}}{{- $suffix := .suffix -}}
{{- if and (eq $.platform "windows") (eq $base "HOME") -}}{{- $base = "_dotfiles_native_home" -}}{{- end -}}
{{- if and (eq $.platform "windows") (get . "windowsSuffix") -}}{{- $suffix = .windowsSuffix -}}{{- end }}
{{- if and (eq $.platform "macos") (get . "macosBase") }}
{{ printf "if [ -f \"${%s}/%s\" ]; then" .macosProbeBase .macosProbe }}
    {{ printf ": \"${%s:=${%s}/%s}\"" .name .macosBase .macosSuffix }}
else
    {{ printf ": \"${%s:=${%s}/%s}\"" .name $base $suffix }}
fi
{{- else }}
{{ printf ": \"${%s:=${%s}/%s}\"" .name $base $suffix }}
{{- end }}
{{- else }}
{{- $value := get . "value" -}}
{{- if (get . "setting") }}{{ $value = index $.sharedShell .setting }}{{ end -}}
{{- if (get . "mirror") }}{{ $value = index (index $.mirrors $.mirror) .mirror }}{{ end -}}
{{- if and (eq $.role "remote-compute") (get . "remote") }}{{ $value = .remote }}{{ end -}}
{{- if and (eq $.platform "windows") (get . "windows") }}{{ $value = .windows }}{{ end }}
{{ printf ": \"${%s:=%s}\"" .name $value }}
{{- end }}
export {{ .name }}
{{ end }}
_dotfiles_prepend_path() {
{{ if eq .platform "windows" -}}
    if command -v cygpath >/dev/null 2>&1; then
        set -- "$(cygpath -u "$1")"
    fi
{{ end -}}
    # Managed tool paths own the front of PATH. Every copy of the path is
    # removed before it is put back at the front: macOS path_helper rewrites
    # PATH after this file runs and would otherwise leave the managed paths
    # behind the system ones. The scan uses parameter expansion only, so it
    # behaves the same in Bash, Zsh and dash.
    _dotfiles_path_rest=''
    _dotfiles_path_scan=$PATH
    while [ -n "$_dotfiles_path_scan" ]; do
        case "$_dotfiles_path_scan" in
            *:*)
                _dotfiles_path_entry=${_dotfiles_path_scan%%:*}
                _dotfiles_path_scan=${_dotfiles_path_scan#*:} ;;
            *)
                _dotfiles_path_entry=$_dotfiles_path_scan
                _dotfiles_path_scan='' ;;
        esac
        if [ "$_dotfiles_path_entry" = "$1" ]; then
            continue
        fi
        _dotfiles_path_rest="${_dotfiles_path_rest:+$_dotfiles_path_rest:}$_dotfiles_path_entry"
    done
    PATH="$1${_dotfiles_path_rest:+:$_dotfiles_path_rest}"
    unset _dotfiles_path_rest _dotfiles_path_scan _dotfiles_path_entry
}
{{ $entries := .sharedShell.pathEntries -}}
{{- $order := .sharedShell.pathOrder -}}
{{- if eq .platform "macos" -}}{{- $order = .sharedShell.macosPathOrder -}}
{{- else if eq .platform "windows" -}}{{- $order = .sharedShell.windowsPathOrder -}}{{- end -}}
{{ range reverse $order -}}
{{- $entry := index $entries . -}}
{{ printf "_dotfiles_prepend_path \"${%s}/%s\"" $entry.base $entry.suffix }}
{{ end -}}
unset -f _dotfiles_prepend_path
{{ if eq .platform "windows" -}}
unset _dotfiles_native_home
{{ end -}}
export PATH
umask {{ .sharedShell.umask }}
# The deployment platform belongs to the shared environment: the shell
# adapters pick their managed runtime from it.
export DOTFILES_PLATFORM={{ .platform | toJson }}

if command -v vivid >/dev/null 2>&1; then
    : "${LS_COLORS:=$(vivid generate dracula)}"
    export LS_COLORS
fi

# Public proxy helpers share one endpoint resolution, owned by with-proxy:
# an explicit PROXY_HTTP wins, otherwise it probes the port the device serves
# (Clash Verge 7897, managed mihomo 7890). Baking the URL in here made a Mac
# running Clash Verge inherit the headless 7890 and fail every request.
# The Nushell adapter asks the same launcher for the same answer, so the shell
# a session runs in never changes the route.
noproxy() {
    if ! command -v with-proxy >/dev/null 2>&1; then
        printf '%s\n' 'noproxy: with-proxy is not installed' >&2
        return 1
    fi
    # The answer is read before it is evaluated, and a launcher that refuses
    # an override is the caller's failure: the session keeps the environment
    # it had instead of a half-applied one.
    _dotfiles_proxy_exports=$(with-proxy --print) || return $?
    eval "$_dotfiles_proxy_exports"
    unset _dotfiles_proxy_exports
}
# unproxy clears the supported inherited proxy variables, the same list the
# direct launcher and the direct fallback clear for their child.
unproxy() { unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy FTP_PROXY ftp_proxy NO_PROXY no_proxy PROXY; }

# Tailspin owns highlighting/paging; arguments and stdin pass through unchanged.
logs() { command tspin "$@"; }

# One guard for managed login entry points. Direct Bash/Zsh stay available;
# credentials and client session markers keep agent subprocesses in POSIX shells.
_dotfiles_can_start_nu() {
    [ -t 0 ] && [ -t 1 ] &&
    [ -z "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CODEX_THREAD_ID:-}${DOTFILES_SECONDARY_SHELL:-}" ] &&
    command -v nu >/dev/null 2>&1
}

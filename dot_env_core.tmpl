# Shared POSIX environment, generated from .chezmoidata.toml.
# Idempotent, and safe for dash, Bash 3.2 and Zsh.
# Load device inputs before shared defaults; this file must also be POSIX-safe.
if [ -f "$HOME/.config/dotfiles/env.local.sh" ]; then
    . "$HOME/.config/dotfiles/env.local.sh"
fi
{{ if eq .platform "windows" -}}
# Git Bash uses POSIX paths for its PATH but Windows-absolute roots for native
# Rust/Python tools. Their filesystem parsers do not understand /c/... paths.
_dotfiles_native_home=$HOME
if command -v cygpath >/dev/null 2>&1; then
    _dotfiles_native_home=$(cygpath -m "$HOME")
fi
{{ end -}}
{{- $defaults := .sharedShell.defaults -}}
{{- if eq .platform "windows" -}}{{- $defaults = concat $defaults .sharedShell.windowsDefaults -}}{{- end -}}
{{ range $defaults -}}
{{- if (get . "base") }}
{{- $base := .base -}}{{- $suffix := .suffix -}}
{{- if and (eq $.platform "windows") (eq $base "HOME") -}}{{- $base = "_dotfiles_native_home" -}}{{- end -}}
{{- if and (eq $.platform "windows") (get . "windowsSuffix") -}}{{- $suffix = .windowsSuffix -}}{{- end }}
{{ printf ": \"${%s:=${%s}/%s}\"" .name $base $suffix }}
{{- else }}
{{- $value := get . "value" -}}
{{- if (get . "setting") }}{{ $value = index $.sharedShell .setting }}{{ end -}}
{{- if (get . "mirror") }}{{ $value = index (index $.mirrors $.mirror) .mirror }}{{ end -}}
{{- if and (eq $.role "remote-compute") (get . "remote") }}{{ $value = .remote }}{{ end -}}
{{- if and (eq $.platform "windows") (get . "windows") }}{{ $value = .windows }}{{ end }}
{{ printf ": \"${%s:=%s}\"" .name $value }}
{{- end }}
export {{ .name }}
{{ end }}
_dotfiles_prepend_path() {
{{ if eq .platform "windows" -}}
    if command -v cygpath >/dev/null 2>&1; then
        set -- "$(cygpath -u "$1")"
    fi
{{ end -}}
    case ":$PATH:" in *":$1:"*) ;; *) PATH="$1${PATH:+:$PATH}" ;; esac
}
{{ $paths := .sharedShell.paths -}}
{{- if eq .platform "windows" -}}{{- $paths = concat $paths .sharedShell.windowsPaths -}}{{- end -}}
{{ range reverse $paths -}}
{{ printf "_dotfiles_prepend_path \"${%s}/%s\"" .base .suffix }}
{{ end -}}
unset -f _dotfiles_prepend_path
{{ if eq .platform "windows" -}}
unset _dotfiles_native_home
{{ end -}}
export PATH
umask {{ .sharedShell.umask }}

if command -v vivid >/dev/null 2>&1; then
    : "${LS_COLORS:=$(vivid generate dracula)}"
    export LS_COLORS
fi

# Public proxy helpers share the configured URL; enabling is deliberate.
noproxy() {
    http_proxy='{{ .proxyUrl | replace "'" "'\"'\"'" }}'
    https_proxy=$http_proxy HTTP_PROXY=$http_proxy HTTPS_PROXY=$http_proxy
    export http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
}
unproxy() { unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; }

# Tailspin owns highlighting/paging; arguments and stdin pass through unchanged.
logs() { command tspin "$@"; }

# One guard for managed login entry points. Direct Bash/Zsh stay available;
# credentials and client session markers keep agent subprocesses in POSIX shells.
_dotfiles_can_start_nu() {
    [ -t 0 ] && [ -t 1 ] &&
    [ -z "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CODEX_THREAD_ID:-}${DOTFILES_SECONDARY_SHELL:-}" ] &&
    command -v nu >/dev/null 2>&1
}

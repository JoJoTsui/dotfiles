changeps1: false
channels:
{{ range (index .mirrors .mirror).condaChannels }}  - {{ . | quote }}
{{ end -}}
show_channel_urls: true
channel_priority: strict
channel_alias: {{ (index .mirrors .mirror).condaChannelAlias | quote }}
{{- if eq .mirror "tuna" }}
custom_channels:
{{ range $channel, $base := (index .mirrors .mirror).condaCustomChannels }}  {{ $channel }}: {{ $base | quote }}
{{ end -}}
mirrored_channels:
{{ range $channel, $mirrors := (index .mirrors .mirror).condaMirrors }}  {{ $channel }}:
{{ range $mirrors }}    - {{ . | quote }}
{{ end }}{{ end }}
{{- end }}
# network settings
remote_connect_timeout_secs: 30
remote_read_timeout_secs: 120
remote_max_retries: 3
remote_backoff_factor: 2

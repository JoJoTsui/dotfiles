# POSIX-safe login environment; .bash_profile delegates here.
[ -f "$HOME/.env_core" ] && . "$HOME/.env_core"
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
case $- in
    *i*)
        if [ -x "$HOME/.local/bin/nu-login" ] && _dotfiles_can_start_nu; then
            exec "$HOME/.local/bin/nu-login"
        fi ;;
esac
